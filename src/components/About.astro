---
import { getCollection } from 'astro:content';
import Brain from '@lucide/astro/icons/brain';
import Network from '@lucide/astro/icons/network';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Users from '@lucide/astro/icons/users';
import Workflow from '@lucide/astro/icons/workflow';
import Section from './ui/Section.astro';
import { site } from '../data/site';

const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);

const icons = { users: Users, shield: ShieldCheck, network: Network, workflow: Workflow, brain: Brain };
---

<Section id="about" index="01" eyebrow="About" title="Building teams and the systems they run">
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <div class="space-y-5 text-base leading-relaxed text-muted">
        {site.bio.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <dl class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line">
        {
          site.stats.map((stat) => (
            <div class="flex flex-col-reverse gap-1 bg-surface p-5">
              <dt class="text-sm text-muted">{stat.label}</dt>
              <dd class="font-mono text-2xl font-semibold tracking-tight text-fg">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="lg:col-span-7">
      <h3 class="sr-only">Core skills</h3>
      <div class="grid gap-4 sm:grid-cols-2">
        {
          skills.map(({ data }, i) => {
            const Icon = icons[data.icon];
            return (
              <article
                class:list={[
                  'rounded-xl border border-line bg-surface p-5 transition-colors duration-200 hover:border-line-strong',
                  i === skills.length - 1 && skills.length % 2 === 1 && 'sm:col-span-2',
                ]}
              >
                <h4 class="flex items-center gap-2.5 text-sm font-semibold text-fg">
                  <Icon class="size-4 text-accent" aria-hidden="true" />
                  {data.title}
                </h4>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {data.items.map((item) => (
                    <li class="rounded-md bg-surface-2 px-2.5 py-1 text-sm text-muted transition-colors duration-150 hover:text-fg">
                      {item}
                    </li>
                  ))}
                </ul>
              </article>
            );
          })
        }
      </div>
    </div>
  </div>
</Section>
