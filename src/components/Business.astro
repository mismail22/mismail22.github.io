---
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import { site } from '../data/site';

const { mba } = site;
---

<Section
  id="mba"
  index="05"
  eyebrow="MBA & business fluency"
  title="An engineer who reads the P&L."
  intro="I completed an MBA with Honors while leading platform work, so budget, vendor, and risk decisions get the same rigor as architecture reviews."
>
  <div class="grid gap-4 lg:grid-cols-5">
    <Panel ticks class="flex flex-col p-7 lg:col-span-2 lg:p-9">
      <div class="flex size-12 items-center justify-center rounded-xl border border-line-strong bg-surface-2 text-accent">
        <GraduationCap class="size-6" aria-hidden="true" />
      </div>
      <p class="sys-label mt-8">{mba.period}</p>
      <h3 class="mt-2 text-2xl font-semibold tracking-[-0.025em]">{mba.degree}</h3>
      <p class="mt-1 text-muted">{mba.school}</p>

      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line">
        <div class="bg-surface p-4">
          <dt class="sys-label">Distinction</dt>
          <dd class="mt-1 font-mono text-lg text-accent">{mba.honors}</dd>
        </div>
        <div class="bg-surface p-4">
          <dt class="sys-label">GPA</dt>
          <dd class="mt-1 font-mono text-lg text-fg">{mba.gpa} / 4.00</dd>
        </div>
      </dl>

      <p class="mt-6 text-sm leading-relaxed text-muted">{mba.note}</p>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Coursework">
        {mba.coursework.map((c) => <li class="rounded-full border border-line px-3 py-1 text-xs text-muted">{c}</li>)}
      </ul>
    </Panel>

    <Panel delay={1} class="flex flex-col p-7 lg:col-span-3 lg:p-9">
      <p class="sys-label flex items-center gap-2"><span class="led" aria-hidden="true"></span>How it shows up</p>
      <dl class="mt-6 grid flex-1 gap-px overflow-hidden rounded-xl border border-line bg-line sm:grid-cols-2">
        {
          mba.applied.map((a) => (
            <div class="flex flex-col-reverse justify-between gap-4 bg-surface p-6">
              <dt class="text-sm leading-relaxed text-muted">{a.label}</dt>
              <dd class="font-mono text-3xl font-medium tracking-tight text-fg">{a.value}</dd>
            </div>
          ))
        }
      </dl>
      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Business toolkit">
        {mba.toolkit.map((t) => <li class="rounded-full bg-surface-2 px-3 py-1.5 text-sm text-muted">{t}</li>)}
      </ul>
    </Panel>
  </div>
</Section>
