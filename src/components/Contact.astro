---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Mail from '@lucide/astro/icons/mail';
import ContactForm from './ContactForm.astro';
import Panel from './ui/Panel.astro';
import BrandIcon from './ui/BrandIcon.astro';
import Section from './ui/Section.astro';
import { site } from '../data/site';

const channels = [
  ...(site.email ? [{ label: 'Email', handle: site.email, href: `mailto:${site.email}`, icon: null }] : []),
  ...site.socials,
];
---

<Section
  id="contact"
  index="07"
  eyebrow="Open a channel"
  title="Building or scaling an infrastructure team? Let's talk."
  intro="I'm looking for engineering leadership roles in infrastructure and platforms. LinkedIn is the fastest way to reach me."
>
  <div class:list={['grid gap-4', site.formspreeId && 'lg:grid-cols-12']}>
    <div class:list={['grid gap-4', site.formspreeId ? 'lg:col-span-5' : 'md:grid-cols-2']}>
      {
        channels.map((c, i) => (
          <Panel as="a" href={c.href} target={c.icon ? '_blank' : undefined} rel={c.icon ? 'noopener me' : undefined} delay={i} ticks class="group flex items-center gap-5 p-6 hover:border-line-strong">
            <span class="flex size-12 shrink-0 items-center justify-center rounded-xl border border-line-strong bg-surface-2 text-muted transition-colors group-hover:text-accent">
              {c.icon ? <BrandIcon name={c.icon} class="size-5" /> : <Mail class="size-5" aria-hidden="true" />}
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-lg font-medium text-fg">{c.label}</span>
              <span class="block truncate font-mono text-sm text-muted">{c.handle}</span>
            </span>
            <ArrowUpRight class="size-5 text-muted transition-all duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent" aria-hidden="true" />
          </Panel>
        ))
      }
    </div>

    {
      site.formspreeId && (
        <div class="lg:col-span-7" data-reveal>
          <ContactForm />
        </div>
      )
    }
  </div>
</Section>
