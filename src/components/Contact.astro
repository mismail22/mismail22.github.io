---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import ContactForm from './ContactForm.astro';
import { site } from '../data/site';

const channels = [...(site.email ? [{ label: 'Email', handle: site.email, href: `mailto:${site.email}`, external: false }] : []), ...site.socials.map((s) => ({ ...s, external: true }))];
---

<section id="contact" aria-labelledby="contact-title" class="relative overflow-hidden border-t border-line py-28 sm:py-40">
  <div class="bg-dots absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_60%_70%_at_20%_40%,#000,transparent)]" aria-hidden="true"></div>
  <div class="container-page">
    <p class="text-lg text-muted" data-reveal>Hiring for a Staff+ infrastructure or infra EM role?</p>
    <h2 id="contact-title" class="mt-4 text-[clamp(3rem,7vw,6rem)] leading-[0.95] font-medium tracking-[-0.045em]" data-reveal style="--i: 1">
      Let's build something.
    </h2>

    <div class:list={['mt-14 grid gap-12', site.formspreeId && 'lg:grid-cols-12']}>
      <ul class:list={['flex flex-col gap-1', site.formspreeId && 'lg:col-span-5']} data-reveal style="--i: 2">
        {
          channels.map((c) => (
            <li>
              <a
                href={c.href}
                target={c.external ? '_blank' : undefined}
                rel={c.external ? 'noopener me' : undefined}
                class="group inline-flex items-baseline gap-4 py-2 text-2xl font-medium tracking-[-0.02em] text-fg transition-colors hover:text-accent-strong sm:text-3xl"
              >
                {c.label}
                <span class="font-mono text-sm font-normal text-muted">{c.handle}</span>
                <ArrowUpRight class="size-5 self-center text-muted transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent" aria-hidden="true" />
              </a>
            </li>
          ))
        }
      </ul>

      {
        site.formspreeId && (
          <div class="lg:col-span-7" data-reveal>
            <ContactForm />
          </div>
        )
      }
    </div>

    <p class="mt-16 text-sm text-muted" data-reveal>{site.humanNote}</p>
  </div>
</section>
