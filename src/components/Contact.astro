---
import SocialLinks from './SocialLinks.astro';
import { site } from '../data/site';
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <p class="eyebrow" data-reveal>04 · Contact</p>
    <h2 id="contact-title" class="display-l" data-reveal>Let's talk.</h2>
    <div class="row" data-reveal>
      <p class="lead">{site.status}. LinkedIn is the fastest way to reach me.</p>
      <SocialLinks size="lg" />
    </div>
    {site.email && <p class="email"><a href={`mailto:${site.email}`}>{site.email}</a></p>}
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(96px, 13vw, 180px);
    border-top: 1px solid var(--line);
  }
  h2 {
    margin-top: 20px;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 40px;
    margin-top: 36px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .lead {
    max-width: 40ch;
  }
  .email {
    margin-top: 24px;
  }
</style>
