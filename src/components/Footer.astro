---
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div class="container-page flex flex-col gap-4 py-10 font-mono text-xs text-muted sm:flex-row sm:items-center sm:justify-between">
    <p class="flex items-center gap-2.5">
      <span class="led led--pulse" aria-hidden="true"></span>
      All systems operational
    </p>
    <p>
      © {year} {site.name} · Built with Astro ·
      <a href={site.repo} target="_blank" rel="noopener" class="underline decoration-line-strong underline-offset-4 hover:text-fg">
        Source
      </a>
    </p>
  </div>
</footer>
