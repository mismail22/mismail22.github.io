---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Button from './ui/Button.astro';
import BrandIcon from './ui/BrandIcon.astro';
import { site } from '../data/site';
import { formatValue } from '../lib/format';

const linkedin = site.socials.find((s) => s.icon === 'linkedin');
---

<section id="top" class="relative isolate flex min-h-[100svh] flex-col overflow-hidden">
  <!-- Decorative layers: grid, career-map topology, readability gradients -->
  <div class="bg-grid absolute inset-0 -z-30 [mask-image:radial-gradient(ellipse_90%_80%_at_70%_30%,#000_30%,transparent_100%)]" aria-hidden="true"></div>
  <canvas class="absolute inset-0 -z-20 size-full opacity-0 transition-opacity duration-1000 max-sm:[&.is-ready]:opacity-35 sm:max-lg:[&.is-ready]:opacity-50 lg:[&.is-ready]:opacity-100" data-topology aria-hidden="true"></canvas>
  <div class="hero-veil pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-linear-to-b from-transparent to-canvas" aria-hidden="true"></div>

  <div class="container-page grid flex-1 grid-cols-12 items-center pt-32 pb-10">
    <div class="col-span-12 lg:col-span-7" data-hero-text>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-3 text-sm text-muted" data-reveal>
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-accent">
          <span class="led led--pulse" aria-hidden="true"></span>
          {site.status}
        </span>
        <span>{site.role}</span>
      </p>

      <h1
        class="mt-8 text-[clamp(2.5rem,0.9rem+5.6vw,5.75rem)] leading-[0.95] font-semibold tracking-[-0.045em] whitespace-nowrap"
        data-reveal
        style="--i: 1"
      >
        {site.name}
      </h1>

      <p class="mt-7 max-w-[30ch] text-[clamp(1.5rem,1rem+1.6vw,2.25rem)] leading-tight font-medium tracking-[-0.02em] text-balance" data-reveal style="--i: 2">
        {site.headline[0]} <span class="text-muted">{site.headline[1]}</span>
      </p>

      <p class="mt-6 max-w-xl text-base leading-relaxed text-muted" data-reveal style="--i: 3">
        {site.intro}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-3" data-reveal style="--i: 4">
        <Button href="#systems" class="rounded-full">
          Hiring a Staff engineer?
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        <Button href="#team" variant="secondary" class="rounded-full">
          Hiring an EM?
          <ArrowRight class="size-4" aria-hidden="true" />
        </Button>
        {
          linkedin && (
            <a
              href={linkedin.href}
              target="_blank"
              rel="noopener me"
              class="inline-flex size-11 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface-2 hover:text-fg"
              aria-label="LinkedIn profile"
            >
              <BrandIcon name="linkedin" class="size-5" />
            </a>
          )
        }
      </div>

      <ul class="mt-9 flex flex-wrap gap-2" aria-label="Core stack" data-reveal style="--i: 5">
        {site.stack.map((s) => <li class="rounded-full border border-line px-3 py-1 font-mono text-xs text-muted">{s}</li>)}
      </ul>
    </div>
  </div>

  <!-- Track record -->
  <div class="container-page pb-8" data-reveal style="--i: 6">
    <div class="panel ticks overflow-hidden rounded-2xl backdrop-blur-sm">
      <i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i><i aria-hidden="true"></i>
      <div class="flex items-center gap-2.5 border-b border-line px-5 py-2.5">
        <span class="led" aria-hidden="true"></span>
        <span class="sys-label">Track record</span>
      </div>
      <dl class="grid grid-cols-2 md:grid-cols-4">
        {
          site.heroTelemetry.map((item, i) => (
            <div class:list={['flex flex-col-reverse gap-1 border-line px-5 py-4', i % 2 === 0 && 'border-r', i < 2 && 'max-md:border-b', i < 3 && 'md:border-r']}>
              <dt class="text-xs text-muted">{item.label}</dt>
              <dd class="font-mono text-xl font-semibold text-fg tabular-nums sm:text-2xl">
                {'from' in item && <span class="text-muted">{item.from}→</span>}
                <span
                  data-count={item.to}
                  data-count-from={'from' in item ? parseFloat(item.from) : 0}
                  data-suffix={'suffix' in item ? item.suffix : ''}
                >
                  {formatValue(item.to, { suffix: 'suffix' in item ? item.suffix : '' })}
                </span>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  /* Readability veil. On desktop it follows the centered text column rather
     than the viewport, so wide screens don't get a black void on the left. */
  .hero-veil {
    background: linear-gradient(180deg, rgb(7 8 10 / 0.5) 0%, rgb(7 8 10 / 0.88) 45%, var(--color-canvas) 100%);
  }

  @media (min-width: 64rem) {
    .hero-veil {
      background: linear-gradient(
        90deg,
        rgb(7 8 10 / 0.6) 0%,
        rgb(7 8 10 / 0.6) calc(50% + 4rem),
        transparent calc(50% + 14rem)
      );
    }
  }
</style>

<script>
  import { initTopology } from '../scripts/topology';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-topology]');
  if (canvas) {
    const start = () => initTopology(canvas);
    // Draw after first paint so the headline is the LCP element.
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 800 });
    else setTimeout(start, 200);
  }
</script>
