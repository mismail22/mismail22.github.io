---
import { getCollection } from 'astro:content';
import Section from './ui/Section.astro';

const incidents = (await getCollection('incidents')).sort((a, b) => a.data.order - b.data.order).map((i) => i.data);
---

<Section
  id="incidents"
  band="cool"
  eyebrow="Incidents"
  title="When it broke."
  intro="Production is where engineering judgment gets tested. Incidents I worked, written like postmortem summaries."
>
  <div class="overflow-hidden rounded-2xl border border-line bg-canvas" data-reveal>
    <div class="flex items-center justify-between gap-4 border-b border-line px-5 py-3 text-xs text-muted sm:px-7">
      <span class="font-mono"><span class="text-accent">$</span> tail incident.log</span>
      <span>{incidents.length} entries · newest first</span>
    </div>
    <ol class="divide-y divide-line">
      {
        incidents.map((inc) => (
          <li class="grid gap-4 px-5 py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8 sm:px-7">
            <div class="flex items-center gap-3 text-xs sm:flex-col sm:items-start sm:gap-2">
              <span class="inline-flex items-center gap-2">
                <span class:list={['led', inc.severity === 'high' ? 'led--amber' : '']} aria-hidden="true" />
                <span class:list={['tracking-widest uppercase', inc.severity === 'high' ? 'text-amber' : 'text-accent']}>
                  {inc.severity === 'high' ? 'High sev' : 'Medium'}
                </span>
              </span>
              <span class="text-muted">{inc.year}</span>
            </div>
            <div>
              <h3 class="text-lg font-medium tracking-[-0.01em] text-fg">{inc.title}</h3>
              <dl class="mt-4 flex flex-col gap-3 text-sm sm:grid sm:grid-cols-2 sm:gap-x-10">
                <div class="order-first sm:order-last sm:col-span-2">
                  <dt class="text-sm text-muted">Result</dt>
                  <dd class="mt-1 font-medium text-accent">{inc.result}</dd>
                </div>
                <div>
                  <dt class="text-sm text-muted">Impact</dt>
                  <dd class="mt-1 text-prose">{inc.impact}</dd>
                </div>
                <div>
                  <dt class="text-sm text-muted">Root cause</dt>
                  <dd class="mt-1 text-prose">{inc.cause}</dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class="text-sm text-muted">Fix</dt>
                  <dd class="mt-1 text-prose">{inc.fix}</dd>
                </div>
              </dl>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
