---
import { getCollection } from 'astro:content';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Section from './ui/Section.astro';
import Tag from './ui/Tag.astro';
import { site } from '../data/site';
import { formatMonth, splitMetrics } from '../lib/format';

// Most recent first; each role is a "release" in the log.
const roles = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start)).map((r) => r.data);
---

<Section
  id="journey"
  index="04"
  eyebrow="Release history"
  title="Sixteen years, versioned."
  intro="From mobile packet core to fleet-scale platforms. Each role is an entry in the log; open one to read the highlights."
>
  <ol class="overflow-hidden rounded-2xl border border-line">
    {
      roles.map((role, i) => {
        const current = role.end === null;
        return (
          <li class="border-b border-line last:border-b-0" data-reveal style={`--i: ${Math.min(i, 4)}`}>
            <details class="log-entry group bg-surface/40 transition-colors hover:bg-surface" open={i === 0}>
              <summary class="grid grid-cols-[auto_1fr_auto] items-center gap-x-4 gap-y-1 px-5 py-5 sm:grid-cols-[4.5rem_1fr_auto_auto] sm:px-7">
                <span class="font-mono text-xs text-muted">v{roles.length - i}.0</span>
                <span class="min-w-0">
                  <span class="flex items-center gap-2.5 font-medium text-fg">
                    <span class={current ? 'led led--pulse' : 'led led--off'} aria-hidden="true" />
                    <span class="truncate">{role.role}</span>
                  </span>
                  <span class="mt-0.5 block text-sm text-muted">
                    {role.company} · {role.location}
                  </span>
                </span>
                <span class="hidden font-mono text-xs text-muted sm:block">
                  <time datetime={role.start}>{formatMonth(role.start)}</time>
                  {' – '}
                  {current ? <span class="text-accent">Present</span> : <time datetime={role.end!}>{formatMonth(role.end!)}</time>}
                </span>
                <ChevronRight class="chevron size-4 text-muted" aria-hidden="true" />
              </summary>

              <div class="px-5 pb-7 sm:px-7 sm:pl-[calc(4.5rem+2.75rem)]">
                <p class="mb-4 font-mono text-xs text-muted sm:hidden">
                  {formatMonth(role.start)} – {current ? 'Present' : formatMonth(role.end!)}
                </p>
                <ul class="max-w-3xl space-y-3">
                  {role.highlights.map((highlight) => (
                    <li class="relative pl-5 text-sm leading-relaxed text-muted before:absolute before:top-[0.65em] before:left-0 before:h-px before:w-2.5 before:bg-accent/60">
                      {splitMetrics(highlight).map((part) => (part.metric ? <span class="font-mono text-fg">{part.text}</span> : part.text))}
                    </li>
                  ))}
                </ul>
                {role.tags.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Focus areas">
                    {role.tags.map((tag) => (
                      <Tag label={tag} />
                    ))}
                  </ul>
                )}
              </div>
            </details>
          </li>
        );
      })
    }
  </ol>

  <h3 class="mt-16 flex items-center gap-2 text-sm font-medium text-fg" data-reveal>
    <GraduationCap class="size-4 text-accent" aria-hidden="true" />
    Education
  </h3>
  <ul class="mt-4 divide-y divide-line border-y border-line">
    {
      site.education.map((edu, i) => (
        <li class="grid gap-x-10 gap-y-1 py-5 sm:grid-cols-[1fr_auto]" data-reveal style={`--i: ${i}`}>
          <div>
            <p class="font-medium text-fg">
              {edu.degree} <span class="font-normal text-muted">· {edu.school}</span>
            </p>
            {'note' in edu && <p class="mt-1 text-sm leading-relaxed text-muted">{edu.note}</p>}
          </div>
          <p class="font-mono text-xs text-muted sm:text-right">{edu.period}</p>
        </li>
      ))
    }
  </ul>
</Section>
