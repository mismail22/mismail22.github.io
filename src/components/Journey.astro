---
import { getCollection } from 'astro:content';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import CompanyLogo from './ui/CompanyLogo.astro';
import Section from './ui/Section.astro';
import Tag from './ui/Tag.astro';
import { site } from '../data/site';
import { formatMonth, splitMetrics } from '../lib/format';

// Roles grouped by employer, most recent first within each group.
const roles = (await getCollection('experience')).sort((a, b) => b.data.start.localeCompare(a.data.start)).map((r) => r.data);
const orgs = site.orgs.map((org) => ({ ...org, roles: roles.filter((r) => r.org === org.id) }));
---

<Section
  id="journey"
  index="04"
  eyebrow="Experience"
  title="Where I've worked."
  intro="Eleven years at Meta and five at Vodafone Egypt, from mobile packet core to fleet-scale platforms. Open a role to read the highlights."
>
  <div class="space-y-16 sm:space-y-20">
    {
      orgs.map((org, oi) => (
        <article class="grid gap-8 lg:grid-cols-12 lg:gap-12" aria-labelledby={`org-${org.id}`}>
          <header class="flex items-start gap-5 lg:sticky lg:top-28 lg:col-span-4 lg:self-start" data-reveal>
            <span class="flex size-16 shrink-0 items-center justify-center rounded-2xl bg-white p-3 shadow-[0_0_0_1px_rgb(255_255_255/0.08)]">
              <CompanyLogo company={org.logo} class="size-full" />
            </span>
            <div>
              <h3 id={`org-${org.id}`} class="text-2xl font-medium tracking-[-0.02em] text-fg">
                {org.name}
              </h3>
              {'note' in org && <p class="text-sm text-muted">{org.note}</p>}
              <p class="mt-3 font-mono text-xs text-muted">
                {org.period} · <span class="text-fg">{org.tenure}</span>
              </p>
              <p class="mt-1 text-sm text-muted">{org.locations}</p>
            </div>
          </header>

          <ol class="relative border-l border-line lg:col-span-8">
            {org.roles.map((role, i) => {
              const current = role.end === null;
              return (
                <li class="relative pl-8 sm:pl-10" data-reveal style={`--i: ${Math.min(i, 4)}`}>
                  <span
                    class:list={['absolute top-[1.65rem] -left-[5px] size-[9px] rounded-full', current ? 'bg-accent shadow-[0_0_10px_var(--color-accent)]' : 'border border-line-strong bg-canvas']}
                    aria-hidden="true"
                  />
                  <details class="log-entry group border-b border-line" open={oi === 0 && i === 0}>
                    <summary class="flex items-start gap-4 py-5">
                      <span class="min-w-0 flex-1">
                        <span class="block text-lg leading-snug font-medium text-fg">{role.role}</span>
                        <span class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
                          {role.logo !== org.logo && (
                            <span class="inline-flex items-center gap-1.5">
                              <span class="flex size-4 items-center justify-center rounded bg-white p-px">
                                <CompanyLogo company={role.logo} class="size-full" />
                              </span>
                              {role.company}
                              <span aria-hidden="true">·</span>
                            </span>
                          )}
                          <span>{role.location}</span>
                          <span aria-hidden="true">·</span>
                          <span class="font-mono text-xs">
                            <time datetime={role.start}>{formatMonth(role.start)}</time>
                            {' – '}
                            {current ? <span class="text-accent">Present</span> : <time datetime={role.end!}>{formatMonth(role.end!)}</time>}
                          </span>
                        </span>
                      </span>
                      <ChevronRight class="chevron mt-1.5 size-4 shrink-0 text-muted" aria-hidden="true" />
                    </summary>
                    <div class="pb-7">
                      <ul class="max-w-3xl space-y-3">
                        {role.highlights.map((highlight) => (
                          <li class="relative pl-5 text-[0.9375rem] leading-relaxed text-prose before:absolute before:top-[0.7em] before:left-0 before:h-px before:w-2.5 before:bg-accent/60">
                            {splitMetrics(highlight).map((part) => (part.metric ? <span class="font-mono text-fg">{part.text}</span> : part.text))}
                          </li>
                        ))}
                      </ul>
                      {role.tags.length > 0 && (
                        <ul class="mt-5 flex flex-wrap gap-1.5" aria-label="Focus areas">
                          {role.tags.map((tag) => (
                            <Tag label={tag} />
                          ))}
                        </ul>
                      )}
                    </div>
                  </details>
                </li>
              );
            })}
          </ol>
        </article>
      ))
    }
  </div>

  <h3 class="mt-20 flex items-center gap-2 text-sm font-medium text-fg" data-reveal>
    <GraduationCap class="size-4 text-accent" aria-hidden="true" />
    Education
  </h3>
  <ul class="mt-4 divide-y divide-line border-y border-line">
    {
      site.education.map((edu, i) => (
        <li class="grid grid-cols-[2.75rem_1fr] gap-x-4 gap-y-1 py-5 sm:grid-cols-[2.75rem_1fr_auto] sm:gap-x-6" data-reveal style={`--i: ${i}`}>
          {'badge' in edu ? (
            <span
              class="flex size-11 items-center justify-center rounded-xl text-sm font-bold tracking-tight text-white"
              style={`background-color: ${edu.badge.color}`}
              aria-hidden="true"
            >
              {edu.badge.text}
            </span>
          ) : (
            <span class="flex size-11 items-center justify-center rounded-xl border border-line bg-surface-2 text-muted" aria-hidden="true">
              <GraduationCap class="size-5" />
            </span>
          )}
          <div class="self-center">
            <p class="font-medium text-fg">
              {edu.degree} <span class="font-normal text-muted">· {edu.school}</span>
            </p>
            {'note' in edu && <p class="mt-1 text-sm leading-relaxed text-muted">{edu.note}</p>}
          </div>
          <p class="col-start-2 font-mono text-xs text-muted sm:col-start-auto sm:self-center sm:text-right">{edu.period}</p>
        </li>
      ))
    }
  </ul>
</Section>
