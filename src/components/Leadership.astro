---
import { getCollection } from 'astro:content';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';

const principles = (await getCollection('leadership')).sort((a, b) => a.data.order - b.data.order).map((p) => p.data);
---

<Section
  id="leadership"
  index="02"
  eyebrow="How I lead"
  title="Four principles, each with a receipt."
  intro="How I run teams, each principle backed by something that actually happened."
>
  <div class="grid gap-4 md:grid-cols-2">
    {
      principles.map((p, i) => (
        <Panel as="article" ticks delay={i} class="group flex flex-col p-7 lg:p-9">
          <p class="font-mono text-sm text-accent">0{i + 1}</p>
          <h3 class="mt-5 text-2xl font-semibold tracking-[-0.025em] text-balance lg:text-[1.7rem] lg:leading-tight">{p.title}</h3>
          <p class="mt-4 flex-1 leading-relaxed text-pretty text-muted">{p.body}</p>
          <div class="mt-8 flex items-center gap-4 border-t border-line pt-5">
            <span class="led" aria-hidden="true" />
            <p class="font-mono text-xl font-medium text-fg tabular-nums">{p.proof.value}</p>
            <p class="text-sm text-muted">{p.proof.label}</p>
          </div>
        </Panel>
      ))
    }
  </div>
</Section>
