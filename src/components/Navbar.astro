---
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import Button from './ui/Button.astro';
import { site } from '../data/site';
import { withBase } from '../lib/format';

const links = [
  { href: '#about', label: 'About' },
  { href: '#projects', label: 'Projects' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="sticky top-0 z-50 border-b border-line/60 bg-canvas/80 backdrop-blur-md">
  <nav class="container-page flex h-16 items-center justify-between" aria-label="Primary">
    <a href="#top" class="rounded font-mono text-sm font-semibold tracking-tight">
      <span class="text-accent">~/</span>{site.handle}
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="nav-link" data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {
      site.resume && (
        <Button href={withBase(site.resume)} variant="secondary" size="sm" class="hidden md:inline-flex" target="_blank" rel="noopener">
          Resume
        </Button>
      )
    }

    <button
      type="button"
      class="inline-flex size-10 items-center justify-center rounded-lg text-muted hover:bg-surface-2 hover:text-fg md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-toggle
    >
      <Menu class="size-5" aria-hidden="true" data-icon-open />
      <X class="hidden size-5" aria-hidden="true" data-icon-close />
    </button>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line/60 md:hidden" data-mobile-menu>
    <ul class="container-page flex flex-col gap-1 py-3">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="nav-link block text-base" data-nav-link>
              {link.label}
            </a>
          </li>
        ))
      }
      {
        site.resume && (
          <li>
            <a href={withBase(site.resume)} class="nav-link block text-base" target="_blank" rel="noopener">
              Resume
            </a>
          </li>
        )
      }
    </ul>
  </div>
</header>

<script>
  import '../scripts/nav';
</script>
