---
import SocialLinks from './SocialLinks.astro';
import { withBase } from '../lib/format';

interface Props {
  current?: 'home' | 'work' | 'about';
}

const { current = 'home' } = Astro.props;
const links = [
  { href: withBase('/work'), label: 'Work', key: 'work' },
  { href: withBase('/about'), label: 'About', key: 'about' },
  { href: withBase('/#contact'), label: 'Contact', key: 'contact' },
];
---

<header class="nav no-print">
  <div class="wrap bar">
    <a class="mark" href={withBase('/')} aria-label="Mohanad Ismail, home">Mohanad Ismail</a>
    <nav class="links" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="end">
      <SocialLinks size="sm" />
      <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-menu" aria-label="Open menu" data-menu-toggle>
        <span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <nav id="site-menu" class="menu" aria-label="Primary" data-menu hidden>
    <ul class="wrap">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={current === link.key ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: rgb(10 11 13 / 0.86);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--nav-h);
  }
  .mark,
  .links a,
  .menu a {
    font-size: 12px;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .mark {
    color: var(--ink);
  }
  .links {
    display: flex;
    gap: 28px;
    margin-left: auto;
  }
  .links a {
    position: relative;
    padding-block: 8px;
    color: var(--muted);
    font-weight: 560;
    transition: color 150ms ease;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
  }
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: var(--signal);
  }
  .end {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .bars,
  .bars::before,
  .bars::after {
    display: block;
    width: 16px;
    height: 1.5px;
    margin-inline: auto;
    background: currentColor;
    transition: transform 200ms var(--ease-out);
  }
  .bars {
    position: relative;
  }
  .bars::before,
  .bars::after {
    content: '';
    position: absolute;
    left: 0;
  }
  .bars::before {
    top: -5px;
  }
  .bars::after {
    top: 5px;
  }
  [aria-expanded='true'] .bars {
    background: transparent;
  }
  [aria-expanded='true'] .bars::before {
    transform: translateY(5px) rotate(45deg);
  }
  [aria-expanded='true'] .bars::after {
    transform: translateY(-5px) rotate(-45deg);
  }

  .menu {
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .menu ul {
    margin: 0;
    padding-block: 8px 16px;
    list-style: none;
  }
  .menu a {
    display: block;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 13px;
  }
  .menu a[aria-current='page'] {
    color: var(--signal);
  }

  @media (max-width: 767px) {
    .links {
      display: none;
    }
    .end {
      margin-left: auto;
    }
    .menu-toggle {
      display: inline-grid;
      place-items: center;
    }
  }
  @media (min-width: 768px) {
    .menu {
      display: none;
    }
  }
</style>
