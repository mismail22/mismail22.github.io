---
import { getCollection } from 'astro:content';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';

const milestones = (await getCollection('orgGrowth')).sort((a, b) => a.data.order - b.data.order).map((m) => m.data);
const final = milestones[milestones.length - 1];

// Org chart geometry: you at the hub, four team leads, five engineers per team.
// Node order controls growth: leads first, then engineers round-robin across teams.
const C = 200;
const leads = [45, 135, 225, 315].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { x: C + Math.cos(a) * 92, y: C + Math.sin(a) * 92, angle: a };
});
type OrgNode = { x: number; y: number; px: number; py: number; lead: boolean };
const nodes: OrgNode[] = leads.map((l) => ({ x: l.x, y: l.y, px: C, py: C, lead: true }));
for (let k = 0; k < 5; k++) {
  leads.forEach((l) => {
    const a = l.angle + (k - 2) * 0.42;
    nodes.push({ x: l.x + Math.cos(a) * 62, y: l.y + Math.sin(a) * 62, px: l.x, py: l.y, lead: false });
  });
}
---

<Section
  id="team"
  navGroup="leadership"
  index="03"
  eyebrow="Team-building story"
  title={`From a 5-person team to a ${final.headcount}-engineer organization.`}
  intro="R&D Infrastructure, Feb 2022 → Mar 2024. Scroll through the milestones to watch the org grow."
>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-16">
    <!-- Pinned org chart -->
    <div class="lg:sticky lg:top-28 lg:self-start">
      <Panel ticks class="p-6 sm:p-8" data-org>
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="sys-label">Engineers</p>
            <p class="mt-2 font-mono text-5xl font-medium tracking-tight tabular-nums" data-org-count>{final.headcount}</p>
          </div>
          <p class="sys-label max-w-[12rem] text-right text-accent" data-org-phase>{final.phase}</p>
        </div>

        <svg viewBox="0 0 400 400" class="mx-auto mt-4 w-full max-w-md" role="img" aria-label={`Org chart: one leader, 4 team leads and 20 engineers, ${final.headcount} engineers in total`}>
          <circle cx={C} cy={C} r="150" fill="none" stroke="var(--color-line)" stroke-dasharray="2 6" />
          {nodes.map((n, i) => <line class="org-link is-on" data-link={i} x1={n.px} y1={n.py} x2={n.x} y2={n.y} />)}
          {nodes.map((n, i) => <circle class="org-node is-on" data-node={i} cx={n.x} cy={n.y} r={n.lead ? 9 : 6} />)}
          <circle cx={C} cy={C} r="22" fill="var(--color-surface-2)" stroke="var(--color-accent)" stroke-width="1.5" />
          <text x={C} y={C + 4} text-anchor="middle" class="fill-fg font-mono text-[11px] font-medium">YOU</text>
        </svg>

        <p class="mt-4 text-xs text-muted">Start and end headcount are actual; counts at the milestones in between are approximate.</p>
      </Panel>
    </div>

    <!-- Milestones -->
    <ol class="relative">
      {
        milestones.map((m, i) => (
          <li
            class="org-step group relative border-l border-line py-8 pl-8 lg:flex lg:min-h-[52vh] lg:flex-col lg:justify-center"
            data-org-step
            data-headcount={m.headcount}
            data-phase={m.phase}
            data-reveal
          >
            <span class="org-step__dot absolute top-10 -left-[5px] size-[9px] rounded-full border border-line-strong bg-canvas lg:top-1/2 lg:-mt-1" aria-hidden="true" />
            <p class="sys-label">
              <span class="text-accent">{String(i + 1).padStart(2, '0')}</span> · {m.phase}
            </p>
            <h3 class="mt-3 text-2xl font-semibold tracking-[-0.025em]">{m.title}</h3>
            <p class="mt-3 max-w-md leading-relaxed text-muted">{m.detail}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  .org-link {
    stroke: var(--color-line);
    stroke-width: 1;
    transition: stroke 500ms var(--ease-out);
  }

  .org-link.is-on {
    stroke: color-mix(in oklab, var(--color-accent) 45%, transparent);
  }

  .org-node {
    fill: var(--color-surface-2);
    stroke: var(--color-line-strong);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
    transition:
      fill 500ms var(--ease-out),
      stroke 500ms var(--ease-out),
      transform 500ms var(--ease-out);
    transform: scale(0.75);
  }

  .org-node.is-on {
    fill: var(--color-accent);
    stroke: var(--color-accent-strong);
    transform: scale(1);
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-accent) 70%, transparent));
  }

  @media (min-width: 64rem) {
    :global(.js) .org-step {
      transition:
        opacity 400ms ease,
        transform 800ms var(--ease-out),
        filter 800ms var(--ease-out);
    }

    :global(.js) .org-step:not([data-active]) {
      opacity: 0.45;
    }

    .org-step[data-active] .org-step__dot {
      border-color: var(--color-accent);
      background: var(--color-accent);
      box-shadow: 0 0 10px var(--color-accent);
    }
  }
</style>

<script>
  import '../scripts/org-growth';
</script>
