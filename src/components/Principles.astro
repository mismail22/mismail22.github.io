---
import { getCollection } from 'astro:content';
import Section from './ui/Section.astro';

const principles = (await getCollection('principles')).sort((a, b) => a.data.order - b.data.order).map((p) => p.data);
---

<Section
  id="principles"
  navGroup="incidents"
  variant="annotation"
  title="How I build."
  intro="Five engineering principles, each backed by something that actually shipped."
>
  <ol class="grid border-t border-line lg:grid-cols-2 lg:gap-x-16">
    {
      principles.map((p, i) => (
        <li class="border-b border-line py-10 sm:py-12" data-reveal style={`--i: ${i % 2}`}>
          <p class="font-mono text-xs text-accent">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="mt-3 text-[clamp(1.5rem,1.1rem+1.4vw,2.25rem)] leading-tight font-medium tracking-[-0.025em] text-balance text-fg">
            {p.title}
          </h3>
          <p class="mt-4 max-w-[52ch] leading-relaxed text-pretty text-prose">{p.body}</p>
          <p class="mt-5 text-sm text-muted">
            <span class="font-mono text-base text-fg">{p.proof.value}</span>
            <span class="mx-2 text-dim">·</span>
            {p.proof.label}
          </p>
        </li>
      ))
    }
  </ol>
</Section>
