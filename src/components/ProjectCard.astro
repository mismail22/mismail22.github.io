---
import type { CollectionEntry } from 'astro:content';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Panel from './ui/Panel.astro';
import BrandIcon from './ui/BrandIcon.astro';
import Tag from './ui/Tag.astro';
import { categories } from '../data/categories';

interface Props {
  id: string;
  project: CollectionEntry<'projects'>['data'];
  index: number;
}

const { id, project, index } = Astro.props;
const hasLinks = Boolean(project.repo || project.demo);
---

<Panel
  as="article"
  delay={index % 3}
  class="group flex flex-col p-6 hover:-translate-y-1 hover:border-line-strong lg:p-7"
  data-project
  data-category={project.category}
>
  <header class="flex items-center justify-between gap-3">
    <p class="flex items-center gap-2 font-mono text-xs text-muted">
      <span class="led led--off transition-colors duration-300 group-hover:bg-accent group-hover:shadow-[0_0_10px_var(--color-accent)]" aria-hidden="true"></span>
      svc/{id}
    </p>
    <p class="sys-label text-accent">{categories[project.category]}</p>
  </header>

  <h3 class="mt-6 text-xl font-semibold tracking-[-0.02em] text-fg">{project.title}</h3>
  {project.context && <p class="mt-1 font-mono text-xs text-muted">{project.context}</p>}
  <p class="mt-4 text-sm leading-relaxed text-pretty text-muted">{project.summary}</p>

  {
    project.metrics.length > 0 && (
      <dl class="mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line">
        {project.metrics.slice(0, 2).map((metric) => (
          <div class="flex flex-col-reverse gap-1 bg-surface p-4">
            <dt class="text-xs text-muted">{metric.label}</dt>
            <dd class="font-mono text-lg font-medium text-fg tabular-nums">{metric.value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <ul class="mt-6 flex flex-wrap gap-1.5" aria-label="Tech stack">
    {project.tags.map((tag) => <Tag label={tag} />)}
  </ul>

  {
    hasLinks && (
      <footer class="mt-auto flex gap-2 pt-6">
        {project.repo && (
          <a
            href={project.repo}
            target="_blank"
            rel="noopener"
            class="inline-flex h-9 items-center gap-2 rounded-full border border-line-strong px-3.5 text-sm text-fg transition-colors hover:border-accent/50"
          >
            <BrandIcon name="github" class="size-4" />
            Repo
            <span class="sr-only">for {project.title} on GitHub</span>
          </a>
        )}
        {project.demo && (
          <a
            href={project.demo}
            target="_blank"
            rel="noopener"
            class="inline-flex h-9 items-center gap-2 rounded-full bg-accent px-3.5 text-sm font-medium text-on-accent transition-colors hover:bg-accent-strong"
          >
            Live Demo
            <ArrowUpRight class="size-4" aria-hidden="true" />
            <span class="sr-only">of {project.title}</span>
          </a>
        )}
      </footer>
    )
  }
</Panel>
