---
import { getCollection } from 'astro:content';
import Brain from '@lucide/astro/icons/brain';
import Network from '@lucide/astro/icons/network';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Users from '@lucide/astro/icons/users';
import Workflow from '@lucide/astro/icons/workflow';
import ProjectCard from './ProjectCard.astro';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import { categories, type Category } from '../data/categories';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const skills = (await getCollection('skills')).sort((a, b) => a.data.order - b.data.order);
const icons = { users: Users, shield: ShieldCheck, network: Network, workflow: Workflow, brain: Brain };

// Only offer filters for categories that actually have projects.
const used = (Object.keys(categories) as Category[]).filter((key) => projects.some((p) => p.data.category === key));
const filters = [{ key: 'all', label: 'All' }, ...used.map((key) => ({ key, label: categories[key] }))];
---

<Section
  id="platforms"
  index="04"
  eyebrow="Platforms"
  title="Still hands-on: the systems behind the results."
  intro="Case studies from my work at Meta, described at a public level of detail, plus open-source work."
>
  {
    used.length > 1 && (
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4" data-reveal>
        <div
          role="group"
          aria-label="Filter projects by category"
          class="flex flex-wrap gap-1 rounded-full border border-line bg-surface p-1"
          data-project-filter
        >
          {filters.map((filter, i) => (
            <button
              type="button"
              data-filter={filter.key}
              aria-pressed={i === 0 ? 'true' : 'false'}
              class="rounded-full px-4 py-1.5 text-sm text-muted transition-colors duration-150 hover:text-fg aria-pressed:bg-surface-2 aria-pressed:text-fg aria-pressed:shadow-[inset_0_0_0_1px_var(--color-line-strong)]"
            >
              {filter.label}
            </button>
          ))}
        </div>
        <p class="font-mono text-xs text-muted" aria-live="polite" data-project-count>
          {projects.length} projects
        </p>
      </div>
    )
  }

  <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
    {projects.map(({ id, data }, i) => <ProjectCard id={id} project={data} index={i} />)}
  </div>

  <h3 class="sys-label mt-20 mb-4 flex items-center gap-2" data-reveal><span class="led" aria-hidden="true"></span>Capability matrix</h3>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {
      skills.map(({ data }, i) => {
        const Icon = icons[data.icon];
        return (
          <Panel delay={i} class="p-5">
            <h4 class="flex items-center gap-2 text-sm font-semibold text-fg">
              <Icon class="size-4 text-accent" aria-hidden="true" />
              {data.title}
            </h4>
            <ul class="mt-4 space-y-1.5">
              {data.items.map((item) => (
                <li class="text-sm text-muted">{item}</li>
              ))}
            </ul>
          </Panel>
        );
      })
    }
  </div>
</Section>

<script>
  import '../scripts/project-filter';
</script>
