---
import { getCollection } from 'astro:content';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import ArchDiagram from './ui/ArchDiagram.astro';
import Section from './ui/Section.astro';
import { withBase } from '../lib/format';

const studies = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order).map((p) => p.data);
---

<Section
  id="systems"
  band="cool"
  index="01"
  eyebrow="Selected systems"
  title="Systems I designed, and why they look that way."
  intro="Three deep dives: problem, constraints, architecture, decisions, results. Described at a public level of detail."
>
  <div class="space-y-20 sm:space-y-28">
    {
      studies.map(({ id, data }, i) => {
        const href = withBase(`/work/${id}`);
        return (
          <article class="group grid items-center gap-10 lg:grid-cols-12 lg:gap-14" data-reveal>
            <div class:list={['lg:col-span-5', i % 2 === 1 && 'lg:order-2']}>
              <p class="font-mono text-xs text-muted">
                <span class="text-accent">Case {String(i + 1).padStart(2, '0')}</span> · {data.period}
              </p>
              <h3 class="mt-4 text-3xl leading-tight font-medium tracking-[-0.03em] text-fg sm:text-4xl">
                <a href={href} class="hover:text-accent-strong">
                  {data.title}
                </a>
              </h3>
              <p class="mt-3 text-lg leading-relaxed text-muted">{data.tagline}</p>

              <dl class="mt-8 grid grid-cols-2 gap-6 border-t border-line pt-6">
                {data.metrics.slice(0, 2).map((m) => (
                  <div class="flex flex-col-reverse gap-1">
                    <dt class="text-sm text-muted">{m.label}</dt>
                    <dd class="font-mono text-2xl font-medium text-fg tabular-nums">{m.value}</dd>
                  </div>
                ))}
              </dl>

              <p class="mt-6 font-mono text-xs text-muted">{data.stack.slice(0, 5).join(' · ')}</p>

              <a href={href} class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-accent">
                Read the case study
                <ArrowRight class="size-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
              </a>
            </div>

            <a
              href={href}
              tabindex="-1"
              aria-hidden="true"
              class:list={['bg-dots block rounded-2xl border border-line p-4 transition-colors group-hover:border-line-strong sm:p-6 lg:col-span-7', i % 2 === 1 && 'lg:order-1']}
              style={`view-transition-name: diagram-${id}`}
            >
              <div class="hidden sm:block">
                <ArchDiagram diagram={data.diagram} label={`${data.title} architecture overview`} compact flow="hover" />
              </div>
              <div class="mx-auto max-w-xs sm:hidden">
                <ArchDiagram diagram={data.diagram} label={`${data.title} architecture overview`} compact vertical flow="hover" />
              </div>
            </a>
          </article>
        );
      })
    }
  </div>

  <h3 class="mt-24 text-sm font-medium text-fg" data-reveal>More work</h3>
  <ul class="mt-4 divide-y divide-line border-y border-line">
    {
      projects.map((p, i) => (
        <li class="grid gap-x-10 gap-y-3 py-6 lg:grid-cols-12" data-reveal style={`--i: ${i}`}>
          <div class="lg:col-span-4">
            <p class="font-medium text-fg">{p.title}</p>
            {p.context && <p class="mt-1 font-mono text-xs text-muted">{p.context}</p>}
          </div>
          <p class="text-sm leading-relaxed text-muted lg:col-span-5">{p.summary}</p>
          <dl class="flex gap-8 lg:col-span-3 lg:justify-end">
            {p.metrics.map((m) => (
              <div class="flex flex-col-reverse">
                <dt class="text-xs text-muted">{m.label}</dt>
                <dd class="font-mono text-lg text-fg">{m.value}</dd>
              </div>
            ))}
          </dl>
        </li>
      ))
    }
  </ul>
</Section>
