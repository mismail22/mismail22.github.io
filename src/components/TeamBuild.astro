---
import { getCollection } from 'astro:content';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import { site } from '../data/site';

const phases = (await getCollection('teamPhases')).sort((a, b) => a.data.order - b.data.order).map((p) => p.data);

const proof = [
  { value: '96.85%', label: 'repair SLA vs 95% target' },
  { value: '90%+', label: 'MTTR improvement, year one' },
  { value: '+43%', label: 'device fleet at flat headcount' },
  { value: '40% → 75%', label: 'team incident handling' },
];

// Org chart: you at the hub, four leads, five engineers per team (24 total).
// The founding five are lit; the rest light up in sequence when revealed.
const FOUNDING = 5;
const C = 200;
const leads = [45, 135, 225, 315].map((deg) => {
  const a = (deg * Math.PI) / 180;
  return { x: C + Math.cos(a) * 92, y: C + Math.sin(a) * 92, angle: a };
});
const nodes = leads.map((l) => ({ x: l.x, y: l.y, px: C, py: C, lead: true }));
for (let k = 0; k < 5; k++) {
  leads.forEach((l) => {
    const a = l.angle + (k - 2) * 0.42;
    nodes.push({ x: l.x + Math.cos(a) * 62, y: l.y + Math.sin(a) * 62, px: l.x, py: l.y, lead: false });
  });
}
---

<Section
  id="team"
  index="05"
  eyebrow="Team build"
  title="I've also built the team."
  intro="R&D Environments, Feb 2022 → Mar 2024: from 5 people to a 24-person organization of FTEs, contractors, and MSP partners supporting ~1,000 labs."
>
  <div class="grid gap-4 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
    <Panel ticks class="flex flex-col p-6 sm:p-8">
      <div class="flex items-baseline justify-between">
        <p class="sys-label">People</p>
        <p class="font-mono text-3xl font-medium tabular-nums"><span class="text-muted">05 →</span> 24</p>
      </div>
      <svg viewBox="0 0 400 400" class="mx-auto mt-4 w-full max-w-sm" role="img" aria-label="Org chart: 5 founding team members grown to 24 people across four teams">
        <circle cx={C} cy={C} r="150" fill="none" stroke="var(--color-line)" stroke-dasharray="2 6" />
        {nodes.map((n, i) => <line class:list={['org-link', i < FOUNDING && 'is-founding']} style={`--d: ${i}`} x1={n.px} y1={n.py} x2={n.x} y2={n.y} />)}
        {nodes.map((n, i) => <circle class:list={['org-node', i < FOUNDING && 'is-founding']} style={`--d: ${i}`} cx={n.x} cy={n.y} r={n.lead ? 9 : 6} />)}
        <circle cx={C} cy={C} r="22" fill="var(--color-surface-2)" stroke="var(--color-accent)" stroke-width="1.5" />
        <text x={C} y={C + 4} text-anchor="middle" class="fill-fg font-mono text-[11px] font-medium">LEAD</text>
      </svg>
      <p class="mt-4 flex items-center gap-4 font-mono text-xs text-muted">
        <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full bg-accent"></span>founding five</span>
        <span class="inline-flex items-center gap-1.5"><span class="size-2 rounded-full border border-accent/60 bg-accent/15"></span>hired and grown</span>
      </p>
    </Panel>

    <Panel delay={1} class="flex flex-col p-6 sm:p-8">
      <ol class="grid gap-6 sm:grid-cols-3">
        {
          phases.map((p, i) => (
            <li class="relative border-t border-line-strong pt-5">
              <span class="absolute -top-[5px] left-0 size-[9px] rounded-full bg-accent shadow-[0_0_10px_var(--color-accent)]" aria-hidden="true" />
              <p class="sys-label">
                <span class="text-accent">{String(i + 1).padStart(2, '0')}</span> · {p.phase}
              </p>
              <p class="mt-1 font-mono text-xs text-muted">{p.when}</p>
              <h3 class="mt-3 font-semibold text-fg">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{p.detail}</p>
            </li>
          ))
        }
      </ol>

      <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-xl border border-line bg-line lg:grid-cols-4">
        {
          proof.map((m) => (
            <div class="flex flex-col-reverse gap-1 bg-surface p-4">
              <dt class="text-xs text-muted">{m.label}</dt>
              <dd class="font-mono text-lg font-medium text-fg tabular-nums">{m.value}</dd>
            </div>
          ))
        }
      </dl>

      <ul class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm text-muted">
        {
          site.teamNotes.map((note) => (
            <li class="flex items-center gap-2">
              <span class="size-1 rounded-full bg-accent" aria-hidden="true" />
              {note}
            </li>
          ))
        }
      </ul>
    </Panel>
  </div>
</Section>

<style>
  .org-link {
    stroke: color-mix(in oklab, var(--color-accent) 45%, transparent);
    stroke-width: 1;
  }

  .org-node {
    fill: var(--color-accent);
    stroke: var(--color-accent-strong);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
  }

  .org-node:not(.is-founding) {
    fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface));
  }

  /* Hired-and-grown nodes light up in sequence once the panel is revealed. */
  @media (prefers-reduced-motion: no-preference) {
    .org-node:not(.is-founding),
    .org-link:not(.is-founding) {
      transition:
        opacity 500ms var(--ease-out),
        transform 500ms var(--ease-out);
      transition-delay: calc(500ms + (var(--d) - 5) * 70ms);
    }

    :global(.js) :global([data-reveal]:not(.is-in)) .org-node:not(.is-founding),
    :global(.js) :global([data-reveal]:not(.is-in)) .org-link:not(.is-founding) {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>
