---
import { getCollection } from 'astro:content';
import Section from './ui/Section.astro';
import { site } from '../data/site';

const phases = (await getCollection('teamPhases')).sort((a, b) => a.data.order - b.data.order).map((p) => p.data);

// Flat org chart: one lead, 24 people on two rings (no management layer is
// implied). The founding five are lit; one was promoted into a lead role; the
// rest light up in sequence when the chart is revealed.
const FOUNDING = 5;
const PROMOTED = 2;
const C = 200;
const ring = (count: number, radius: number, offset: number) =>
  Array.from({ length: count }, (_, i) => {
    const a = offset + (i / count) * Math.PI * 2;
    return { x: C + Math.cos(a) * radius, y: C + Math.sin(a) * radius };
  });
const nodes = [...ring(8, 82, -Math.PI / 2), ...ring(16, 150, -Math.PI / 2 + Math.PI / 16)];
const promoted = nodes[PROMOTED];
---

<Section
  id="team"
  band="warm"
  variant="annotation"
  title="And I've built the team."
  intro="R&D Infrastructure, Feb 2022 → Mar 2024: from 5 people to a 24-person organization of FTEs, contractors, and MSP partners running ~1,000 labs across data centers and VR/AR environments."
>
  <div class="grid gap-14 lg:grid-cols-12 lg:gap-16">
    <figure class="lg:sticky lg:top-28 lg:col-span-5 lg:self-start" data-reveal>
      <svg viewBox="0 0 400 400" class="mx-auto w-full max-w-md" role="img" aria-label="Team chart: 5 founding members grown to 24 people, one promoted into a lead role">
        <circle cx={C} cy={C} r="82" fill="none" stroke="var(--color-line)" stroke-dasharray="2 6" />
        <circle cx={C} cy={C} r="150" fill="none" stroke="var(--color-line)" stroke-dasharray="2 6" />
        {nodes.map((n, i) => <line class:list={['org-link', i < FOUNDING && 'is-founding']} style={`--d: ${i}`} x1={C} y1={C} x2={n.x} y2={n.y} />)}
        {nodes.map((n, i) => <circle class:list={['org-node', i < FOUNDING && 'is-founding']} style={`--d: ${i}`} cx={n.x} cy={n.y} r="7" />)}
        <circle cx={promoted.x} cy={promoted.y} r="13" fill="none" stroke="var(--color-accent)" stroke-width="1.25" class="org-promoted" />
        <text x={promoted.x + 18} y={promoted.y + 4} class="fill-muted font-mono text-[10px]">promoted to lead</text>
        <circle cx={C} cy={C} r="24" fill="var(--color-surface-2)" stroke="var(--color-accent)" stroke-width="1.5" />
        <text x={C} y={C + 4} text-anchor="middle" class="fill-fg font-mono text-[11px] font-medium">ME</text>
      </svg>
      <figcaption class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-mono text-xs text-muted">
        <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-accent"></span>founding five</span>
        <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full border border-accent/60 bg-accent/20"></span>hired and grown</span>
        <span class="text-fg">5 → 24 in two years</span>
      </figcaption>
    </figure>

    <div class="lg:col-span-7">
      <ol class="relative border-l border-line-strong">
        {
          phases.map((p, i) => (
            <li class="relative pb-10 pl-8 last:pb-0" data-reveal style={`--i: ${i}`}>
              <span class="absolute top-2 -left-[5px] size-[9px] rounded-full bg-accent" aria-hidden="true" />
              <p class="font-mono text-xs text-muted">
                <span class="text-accent">{String(i + 1).padStart(2, '0')} · {p.phase}</span> · {p.when}
              </p>
              <h3 class="mt-2 text-xl font-medium tracking-[-0.015em] text-fg">{p.title}</h3>
              <p class="mt-2 max-w-[56ch] leading-relaxed text-prose">{p.detail}</p>
            </li>
          ))
        }
      </ol>

      <dl class="mt-12 grid grid-cols-2 gap-x-8 gap-y-6 border-t border-line pt-8 sm:grid-cols-3" data-reveal>
        {
          site.teamProof.map((m) => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-sm text-muted">{m.label}</dt>
              <dd class="font-mono text-2xl font-medium text-fg tabular-nums">{m.value}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-12 grid gap-8 border-t border-line pt-8 sm:grid-cols-2" data-reveal>
        {
          site.teamPrinciples.map((p) => (
            <div>
              <h3 class="text-lg leading-snug font-medium text-fg">{p.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-prose">{p.body}</p>
            </div>
          ))
        }
      </div>

      <ul class="mt-10 space-y-2 text-sm text-muted" data-reveal>
        {
          site.teamNotes.map((note) => (
            <li class="flex items-center gap-3">
              <span class="h-px w-3 bg-accent" aria-hidden="true" />
              {note}
            </li>
          ))
        }
      </ul>

      <p class="mt-10 max-w-[60ch] border-l-2 border-accent pl-5 text-lg leading-relaxed text-fg" data-reveal>
        {site.teamClosing}
      </p>
    </div>
  </div>
</Section>

<style>
  .org-link {
    stroke: color-mix(in oklab, var(--color-accent) 35%, transparent);
    stroke-width: 1;
  }

  .org-node {
    fill: var(--color-accent);
    stroke: var(--color-accent-strong);
    stroke-width: 1;
    transform-box: fill-box;
    transform-origin: center;
  }

  .org-node:not(.is-founding) {
    fill: color-mix(in oklab, var(--color-accent) 22%, var(--color-band-warm));
    stroke: color-mix(in oklab, var(--color-accent) 60%, transparent);
  }

  /* Hired-and-grown nodes light up in sequence once the chart is revealed. */
  @media (prefers-reduced-motion: no-preference) {
    .org-node:not(.is-founding),
    .org-link:not(.is-founding) {
      transition:
        opacity 500ms var(--ease-out),
        transform 500ms var(--ease-out);
      transition-delay: calc(400ms + (var(--d) - 5) * 60ms);
    }

    :global(.js) :global([data-reveal]:not(.is-in)) .org-node:not(.is-founding),
    :global(.js) :global([data-reveal]:not(.is-in)) .org-link:not(.is-founding) {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>
