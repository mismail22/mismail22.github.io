---
import { getCollection } from 'astro:content';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Section from './ui/Section.astro';
import { withBase } from '../lib/format';

// Unboxed ledger: big number, label, link to the evidence. Only numbers that
// aren't already in the hero's track-record bar.
const rows = (await getCollection('telemetry')).sort((a, b) => a.data.order - b.data.order).map((r) => r.data);
const resolve = (href: string) => (href.startsWith('/') ? withBase(href) : href);
---

<Section id="impact" variant="annotation" title="Impact, measured.">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
    <p class="text-xl leading-relaxed text-pretty text-muted lg:sticky lg:top-28 lg:col-span-4 lg:self-start" data-reveal>
      A few numbers that matter, each linked to the work behind it. Systems first; the team story comes later.
    </p>
    <ol class="divide-y divide-line border-y border-line lg:col-span-8">
      {
        rows.map((row, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a
              href={resolve(row.href)}
              class="group grid grid-cols-1 items-baseline gap-x-8 gap-y-2 py-7 sm:grid-cols-[minmax(10rem,auto)_1fr_auto]"
            >
              <span class="font-mono text-[clamp(2.5rem,5vw,4rem)] leading-none font-medium tracking-tight text-fg tabular-nums">
                {row.value}
              </span>
              <span class="text-base leading-relaxed text-muted transition-colors group-hover:text-fg">{row.label}</span>
              <ArrowUpRight class="hidden size-5 text-muted transition-all group-hover:-translate-y-0.5 group-hover:translate-x-0.5 group-hover:text-accent sm:block" aria-hidden="true" />
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
