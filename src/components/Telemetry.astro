---
import { getCollection } from 'astro:content';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';
import { formatValue } from '../lib/format';

const items = (await getCollection('telemetry')).sort((a, b) => a.data.order - b.data.order).map((i) => i.data);
const systems = items.filter((i) => i.group === 'systems');
const [org, ...team] = items.filter((i) => i.group === 'team');

type Item = (typeof items)[number];

// Count from the "before" value when there is one, so 81 → 10 counts down.
const countAttrs = (item: Item) => ({
  'data-count': item.to,
  'data-count-from': item.from ? parseFloat(item.from) : 0,
  'data-prefix': item.prefix,
  'data-suffix': item.suffix,
  'data-decimals': item.decimals,
});
const display = (item: Item) => formatValue(item.to, item);
const founding = org.from ? parseInt(org.from, 10) : 0;
---

<Section id="impact" index="01" eyebrow="Impact telemetry" title="Impact, measured." intro="Systems first, then the team behind them.">
  <p class="sys-label mb-4 flex items-center gap-2" data-reveal><span class="led" aria-hidden="true"></span>Systems</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      systems.map((item, i) => (
        <Panel ticks delay={i} class="flex flex-col justify-between gap-8 p-6">
          <p class="font-mono text-3xl font-medium tracking-tight tabular-nums lg:text-4xl">
            {item.from && <span class="text-muted">{item.from} → </span>}
            <span class="text-fg" {...countAttrs(item)}>
              {display(item)}
            </span>
          </p>
          <div>
            <p class="text-sm text-fg">{item.label}</p>
            {item.detail && <p class="mt-1 font-mono text-xs text-muted">{item.detail}</p>}
          </div>
        </Panel>
      ))
    }
  </div>

  <p class="sys-label mt-12 mb-4 flex items-center gap-2" data-reveal><span class="led" aria-hidden="true"></span>Team</p>
  <div class="grid gap-4 lg:grid-cols-3">
    <Panel ticks class="flex flex-col gap-8 p-6 sm:flex-row sm:items-center sm:justify-between lg:col-span-2">
      <div>
        <p class="font-mono text-4xl font-medium tracking-tight tabular-nums">
          {org.from && <span class="text-muted">{org.from} → </span>}
          <span class="text-fg" {...countAttrs(org)}>{display(org)}</span>
        </p>
        <p class="mt-3 text-sm text-fg">{org.label}</p>
        {org.detail && <p class="mt-1 font-mono text-xs text-muted">{org.detail}</p>}
      </div>
      <ul class="grid w-full max-w-xs grid-cols-8 gap-2" aria-label={`${founding} founding members grown to ${org.to}`}>
        {
          Array.from({ length: org.to }, (_, i) => (
            <li
              class:list={['org-dot aspect-square rounded-full', i < founding ? 'bg-accent shadow-[0_0_10px_var(--color-accent)]' : 'org-dot--new border border-accent/60 bg-accent/15']}
              style={`--d: ${i}`}
            />
          ))
        }
      </ul>
    </Panel>
    {
      team.map((item, i) => (
        <Panel ticks delay={i + 1} class="flex flex-col justify-between gap-8 p-6">
          <p class="font-mono text-4xl font-medium tracking-tight tabular-nums">
            {item.from && <span class="text-muted">{item.from} → </span>}
            <span class="text-fg" {...countAttrs(item)}>
              {display(item)}
            </span>
          </p>
          <div>
            <p class="text-sm text-fg">{item.label}</p>
            {item.detail && <p class="mt-1 font-mono text-xs text-muted">{item.detail}</p>}
          </div>
        </Panel>
      ))
    }
  </div>
</Section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .org-dot--new {
      transition:
        opacity 500ms var(--ease-out),
        transform 500ms var(--ease-out);
      transition-delay: calc(400ms + (var(--d) - 5) * 45ms);
    }

    :global(.js) :global([data-reveal]:not(.is-in)) .org-dot--new {
      opacity: 0;
      transform: scale(0.2);
    }
  }
</style>
