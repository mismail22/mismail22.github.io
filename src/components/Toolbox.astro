---
import { getCollection } from 'astro:content';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Brain from '@lucide/astro/icons/brain';
import Database from '@lucide/astro/icons/database';
import Layers from '@lucide/astro/icons/layers';
import Network from '@lucide/astro/icons/network';
import Panel from './ui/Panel.astro';
import Section from './ui/Section.astro';

const tools = (await getCollection('toolbox')).sort((a, b) => a.data.order - b.data.order).map((t) => t.data);

const groups = [
  { key: 'network', title: 'Networking', icon: Network },
  { key: 'platform', title: 'Platforms', icon: Layers },
  { key: 'ai', title: 'AI / ML', icon: Brain },
  { key: 'data', title: 'Data', icon: Database },
] as const;
---

<Section
  id="toolbox"
  index="06"
  eyebrow="Toolbox"
  title="Tools, with receipts."
  intro="Every skill here comes with where I used it. Open a row to see the evidence."
>
  <div class="grid gap-4 lg:grid-cols-2">
    {
      groups.map((g, gi) => {
        const items = tools.filter((t) => t.group === g.key);
        if (!items.length) return null;
        return (
          <Panel delay={gi % 2} class="overflow-hidden">
            <h3 class="flex items-center gap-2.5 border-b border-line px-5 py-4 text-sm font-semibold text-fg sm:px-6">
              <g.icon class="size-4 text-accent" aria-hidden="true" />
              {g.title}
              <span class="ml-auto font-mono text-xs font-normal text-muted">{items.length}</span>
            </h3>
            <ul class="divide-y divide-line">
              {items.map((t) => (
                <li>
                  <details class="log-entry group">
                    <summary class="flex items-center gap-3 px-5 py-3.5 transition-colors hover:bg-surface-2 sm:px-6">
                      <span class="min-w-0 flex-1 text-sm text-fg">{t.skill}</span>
                      <span class="hidden shrink-0 font-mono text-xs text-muted sm:inline">{t.where}</span>
                      <ChevronRight class="chevron size-4 shrink-0 text-muted" aria-hidden="true" />
                    </summary>
                    <p class="px-5 pb-4 text-sm leading-relaxed text-muted sm:px-6">
                      <span class="font-mono text-xs text-accent sm:hidden">{t.where} · </span>
                      {t.evidence}
                    </p>
                  </details>
                </li>
              ))}
            </ul>
          </Panel>
        );
      })
    }
  </div>
</Section>
