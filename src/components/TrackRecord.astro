---
// Hero "instrument cluster": result as the big number, a micro-visual of the
// change on a fixed-height row (so captions line up), and the baseline in the
// caption. Only the hero counts up.
import { site } from '../data/site';
import { formatValue } from '../lib/format';

type Item = (typeof site.heroTelemetry)[number];
const count = (item: Item) => ('count' in item ? item.count : undefined);
---

<div class="track overflow-hidden rounded-2xl border border-line">
  <div class="flex items-center justify-between border-b border-line px-5 py-3 text-sm text-muted sm:px-6">
    <span>Track record</span>
    <span>2010 → 2026</span>
  </div>
  <dl class="grid grid-cols-2 md:grid-cols-4">
    {
      site.heroTelemetry.map((item, i) => {
        const c = count(item);
        return (
          <div class:list={['flex flex-col border-line p-5 sm:p-6', i % 2 === 0 && 'border-r', i < 2 && 'max-md:border-b', i < 3 && 'md:border-r']}>
            <dd class="text-metric text-fg">
              {c ? (
                <span data-count={c.to} data-count-from={'from' in c ? c.from : 0}>
                  {formatValue(c.to)}
                </span>
              ) : (
                item.value
              )}
              {'unit' in item && <span class="ml-1.5 font-sans text-base font-normal tracking-normal text-muted">{item.unit}</span>}
            </dd>
            <dt class="mt-3 text-sm text-fg">{item.label}</dt>

            <div class="mt-4 flex h-6 items-center" aria-hidden="true">
              {item.viz === 'ruler' && (
                <span class="flex h-1.5 w-full gap-[3px]">
                  {Array.from({ length: 16 }, (_, s) => (
                    <span class:list={['seg flex-1 rounded-full', s < 5 ? 'bg-line-strong' : 'bg-accent']} style={`--d: ${s}`} />
                  ))}
                </span>
              )}
              {item.viz === 'scale' && (
                <span class="block h-1.5 w-full rounded-full bg-line">
                  <span class="grow-bar block h-full w-[90%] rounded-full bg-accent" />
                </span>
              )}
              {item.viz === 'shrink' && (
                <span class="flex w-full flex-col gap-1.5">
                  <span class="block h-1.5 rounded-full bg-line-strong" />
                  <span class="shrink-bar block h-1.5 w-full rounded-full bg-accent" style="--ratio: 0.123" />
                </span>
              )}
              {item.viz === 'dots' && (
                <span class="grid w-full grid-cols-12 gap-1">
                  {Array.from({ length: 24 }, (_, d) => (
                    <span class:list={['dot mx-auto size-2 rounded-full', d < 5 ? 'bg-accent' : 'dot--new border border-accent/60']} style={`--d: ${d}`} />
                  ))}
                </span>
              )}
            </div>

            <p class="mt-3 text-xs leading-snug text-muted">{item.caption}</p>
          </div>
        );
      })
    }
  </dl>
</div>

<style>
  /* Solid backdrop instead of blur: blurring over the animated canvas repaints every frame. */
  .track {
    background: rgb(12 14 17 / 0.9);
  }

  .grow-bar,
  .shrink-bar {
    transform-origin: left;
  }

  .shrink-bar {
    transform: scaleX(var(--ratio));
  }

  @media (prefers-reduced-motion: no-preference) {
    .grow-bar,
    .shrink-bar {
      transition: transform 800ms var(--ease-out) 400ms;
    }
    .seg,
    .dot--new {
      transition: opacity 300ms var(--ease-out);
      transition-delay: calc(400ms + var(--d) * 40ms);
    }

    :global(.js) :global([data-reveal]:not(.is-in)) .grow-bar {
      transform: scaleX(0);
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .shrink-bar {
      transform: scaleX(1);
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .seg,
    :global(.js) :global([data-reveal]:not(.is-in)) .dot--new {
      opacity: 0;
    }
  }
</style>
