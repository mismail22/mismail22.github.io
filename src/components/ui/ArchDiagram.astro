---
// Renders a case-study architecture diagram from data: nodes sit on a grid
// (col/row), edges are drawn as curves with animated "traffic".
import type { CollectionEntry } from 'astro:content';

type Diagram = CollectionEntry<'work'>['data']['diagram'];

interface Props {
  diagram: Diagram;
  label: string;
  // Thumbnail mode: smaller text, no sub-labels
  compact?: boolean;
  class?: string;
}

const { diagram, label, compact = false, class: className } = Astro.props;

const COL_W = 200;
const ROW_H = compact ? 80 : 96;
const W = 164;
const H = compact ? 44 : 58;
const PAD = 12;

const pos = new Map(diagram.nodes.map((n) => [n.id, { x: PAD + n.col * COL_W, y: PAD + n.row * ROW_H }]));
const width = PAD * 2 + Math.max(...diagram.nodes.map((n) => n.col)) * COL_W + W;
const height = PAD * 2 + Math.max(...diagram.nodes.map((n) => n.row)) * ROW_H + H;

// Leave from the side facing the target; curve with a smooth cubic.
const edgePath = (from: string, to: string) => {
  const a = pos.get(from)!;
  const b = pos.get(to)!;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  if (Math.abs(dx) >= Math.abs(dy) * 1.2) {
    const sx = dx > 0 ? a.x + W : a.x;
    const ex = dx > 0 ? b.x : b.x + W;
    const sy = a.y + H / 2;
    const ey = b.y + H / 2;
    const mx = (sx + ex) / 2;
    return `M${sx},${sy} C${mx},${sy} ${mx},${ey} ${ex},${ey}`;
  }
  const sx = a.x + W / 2;
  const ex = b.x + W / 2;
  const sy = dy > 0 ? a.y + H : a.y;
  const ey = dy > 0 ? b.y : b.y + H;
  const my = (sy + ey) / 2;
  return `M${sx},${sy} C${sx},${my} ${ex},${my} ${ex},${ey}`;
};

const markerId = `arrow-${Math.random().toString(36).slice(2, 8)}`;
---

<svg viewBox={`0 0 ${width} ${height}`} class:list={['arch', compact && 'arch--compact', className]} role="img" aria-label={label}>
  <defs>
    <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L8,4 L0,8 z" class="arch-arrow"></path>
    </marker>
  </defs>

  {
    diagram.edges.map(([from, to]) => {
      const d = edgePath(from, to);
      return (
        <g>
          <path d={d} class="arch-edge" marker-end={`url(#${markerId})`} />
          <path d={d} class="arch-flow" />
        </g>
      );
    })
  }

  {
    diagram.nodes.map((n) => {
      const p = pos.get(n.id)!;
      const confirm = n.sub?.includes('CONFIRM');
      return (
        <g transform={`translate(${p.x} ${p.y})`} class={`arch-node arch-node--${n.kind}`}>
          <rect width={W} height={H} rx="10" />
          <text x={W / 2} y={compact || !n.sub ? H / 2 + 4 : H / 2 - 3} text-anchor="middle" class="arch-label">
            {n.label}
          </text>
          {!compact && n.sub && (
            <text x={W / 2} y={H / 2 + 13} text-anchor="middle" class:list={['arch-sub', confirm && 'arch-sub--confirm']}>
              {n.sub}
            </text>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .arch {
    width: 100%;
    height: auto;
    font-family: var(--font-mono);
  }

  .arch-edge {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 1.25;
  }

  .arch-arrow {
    fill: var(--color-line-strong);
  }

  .arch-flow {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 3 14;
    opacity: 0.7;
    animation: arch-flow 1.6s linear infinite;
  }

  .arch-node rect {
    fill: var(--color-surface-2);
    stroke: var(--color-line-strong);
    stroke-width: 1;
  }

  .arch-node--core rect {
    fill: var(--color-surface);
    stroke: color-mix(in oklab, var(--color-accent) 55%, transparent);
  }

  .arch-node--guard rect {
    stroke: var(--color-accent);
    stroke-dasharray: 4 3;
  }

  .arch-node--surface rect {
    stroke-dasharray: 2 3;
  }

  .arch-node--target rect {
    fill: color-mix(in oklab, var(--color-accent) 9%, var(--color-surface));
    stroke: var(--color-accent);
  }

  .arch-label {
    fill: var(--color-fg);
    font-size: 11.5px;
    font-weight: 500;
  }

  .arch--compact .arch-label {
    font-size: 12.5px;
  }

  .arch-sub {
    fill: var(--color-muted);
    font-size: 9.5px;
  }

  .arch-sub--confirm {
    fill: #fbbf24;
  }

  @keyframes arch-flow {
    to {
      stroke-dashoffset: -17;
    }
  }
</style>
