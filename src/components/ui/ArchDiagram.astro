---
// Renders a case-study architecture diagram from data: nodes sit on a grid
// (col/row) and edges are drawn as curves. Nodes with a `callout` get a
// numbered badge that links to the matching decision record.
import type { CollectionEntry } from 'astro:content';

type Diagram = CollectionEntry<'work'>['data']['diagram'];

interface Props {
  diagram: Diagram;
  label: string;
  // Thumbnail mode: smaller, no sub-labels or callouts
  compact?: boolean;
  // Swap rows and columns (top-to-bottom flow for narrow screens)
  vertical?: boolean;
  // Prefix for callout links, e.g. "#decision-" → #decision-1
  calloutHref?: string;
  class?: string;
}

const { diagram, label, compact = false, vertical = false, calloutHref, class: className } = Astro.props;

const COL_W = vertical ? 178 : 200;
const ROW_H = compact ? 80 : vertical ? 92 : 100;
const W = vertical ? 158 : 164;
const H = compact ? 44 : 58;
const PAD = 14;

const place = (n: Diagram['nodes'][number]) => (vertical ? { c: n.row, r: n.col } : { c: n.col, r: n.row });
const pos = new Map(diagram.nodes.map((n) => [n.id, { x: PAD + place(n).c * COL_W, y: PAD + place(n).r * ROW_H }]));
const width = PAD * 2 + Math.max(...diagram.nodes.map((n) => place(n).c)) * COL_W + W;
const height = PAD * 2 + Math.max(...diagram.nodes.map((n) => place(n).r)) * ROW_H + H;

// Leave from the side facing the target; curve with a smooth cubic.
const edgePath = (from: string, to: string) => {
  const a = pos.get(from)!;
  const b = pos.get(to)!;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  if (Math.abs(dx) >= Math.abs(dy) * 1.2) {
    const sx = dx > 0 ? a.x + W : a.x;
    const ex = dx > 0 ? b.x : b.x + W;
    const sy = a.y + H / 2;
    const ey = b.y + H / 2;
    const mx = (sx + ex) / 2;
    return `M${sx},${sy} C${mx},${sy} ${mx},${ey} ${ex},${ey}`;
  }
  const sx = a.x + W / 2;
  const ex = b.x + W / 2;
  const sy = dy > 0 ? a.y + H : a.y;
  const ey = dy > 0 ? b.y : b.y + H;
  const my = (sy + ey) / 2;
  return `M${sx},${sy} C${sx},${my} ${ex},${my} ${ex},${ey}`;
};

const markerId = `arrow-${Math.random().toString(36).slice(2, 8)}`;
const showCallouts = !compact && Boolean(calloutHref);
---

<svg viewBox={`0 0 ${width} ${height}`} class:list={['arch', compact && 'arch--compact', className]} role="img" aria-label={label}>
  <defs>
    <marker id={markerId} viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L8,4 L0,8 z" class="arch-arrow"></path>
    </marker>
  </defs>

  {diagram.edges.map(([from, to]) => <path d={edgePath(from, to)} class="arch-edge" marker-end={`url(#${markerId})`} />)}

  {
    diagram.nodes.map((n) => {
      const p = pos.get(n.id)!;
      return (
        <g transform={`translate(${p.x} ${p.y})`} class={`arch-node arch-node--${n.kind}`}>
          <rect width={W} height={H} rx="2" />
          <text x={W / 2} y={compact || !n.sub ? H / 2 + 4 : H / 2 - 3} text-anchor="middle" class="arch-label">
            {n.label}
          </text>
          {!compact && n.sub && (
            <text x={W / 2} y={H / 2 + 13} text-anchor="middle" class="arch-sub">
              {n.sub}
            </text>
          )}
          {showCallouts && n.callout && (
            <a href={`${calloutHref}${n.callout}`} class="arch-callout" aria-label={`Decision ${n.callout}`}>
              <circle cx={W - 2} cy="2" r="10" />
              <text x={W - 2} y="6" text-anchor="middle">
                {n.callout}
              </text>
            </a>
          )}
        </g>
      );
    })
  }
</svg>

<style>
  .arch {
    width: 100%;
    height: auto;
    overflow: visible;
    font-family: var(--mono);
  }
  .arch-edge {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1.25;
  }
  .arch-arrow {
    fill: var(--line-strong);
  }
  .arch-node rect {
    fill: var(--surface);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .arch-node--source rect {
    fill: var(--bg);
  }
  .arch-node--core rect {
    stroke: var(--ink-2);
  }
  .arch-node--surface rect {
    stroke-dasharray: 3 3;
  }
  .arch-node--guard rect {
    fill: rgb(255 176 32 / 0.08);
    stroke: var(--signal);
  }
  .arch-node--target rect {
    fill: var(--surface-2);
    stroke: var(--ink);
  }
  .arch-label {
    fill: var(--ink);
    font-size: 11.5px;
    font-weight: 500;
  }
  .arch--compact .arch-label {
    font-size: 12.5px;
  }
  .arch-sub {
    fill: var(--muted);
    font-size: 9.5px;
  }
  .arch-callout circle {
    fill: var(--signal);
    stroke: var(--bg);
    stroke-width: 2;
    transition: fill 150ms ease;
  }
  .arch-callout text {
    fill: var(--signal-ink);
    font-size: 11px;
    font-weight: 700;
  }
  .arch-callout:hover circle,
  .arch-callout:focus-visible circle {
    fill: #ffc65c;
  }
</style>
