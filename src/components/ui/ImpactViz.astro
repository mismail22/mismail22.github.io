---
// Small, honest visuals for impact cards. Every shape is drawn from real data
// in telemetry.json; nothing implies a total that isn't known. Final state is
// server-rendered; motion only plays when the card is revealed.
interface Props {
  viz: 'timeline' | 'blocks' | 'shrink' | 'matrix' | 'chain' | 'percentile';
  data: Record<string, string | number>;
}

const { viz, data } = Astro.props;
const n = (k: string) => Number(data[k]);
const years = viz === 'timeline' ? Array.from({ length: n('end') - n('start') + 1 }, (_, i) => n('start') + i) : [];
---

<div class:list={['viz', `viz--${viz}`]} aria-hidden="true">
  {
    viz === 'timeline' && (
      <div class="flex h-full flex-col justify-end gap-3">
        <div class="relative h-7">
          <span class="tl-span absolute inset-y-1.5 left-0 right-3 rounded-sm" />
          <span class="tl-marker absolute top-1/2 right-0 size-4 -translate-y-1/2 rounded-full border-2 border-accent bg-canvas" />
        </div>
        <div class="flex justify-between font-mono text-[11px] text-muted">
          {years.map((y) => <span>{y}</span>)}
        </div>
        <div class="flex gap-5 font-mono text-[11px] text-muted">
          <span class="inline-flex items-center gap-2"><span class="tl-key h-2 w-4 rounded-sm" />{data.hidden}</span>
          <span class="inline-flex items-center gap-2"><span class="size-2 rounded-full bg-accent" />{data.found}</span>
        </div>
      </div>
    )
  }

  {
    viz === 'blocks' && (
      <div class="flex h-full flex-col justify-end gap-3">
        <div class="grid grid-cols-3 gap-2">
          {Array.from({ length: n('count') }, (_, i) => (
            <span class="blk relative flex h-12 items-center justify-center overflow-hidden rounded-lg border border-line-strong font-mono text-xs text-fg" style={`--d: ${i}`}>
              <span class="blk-fill absolute inset-0" />
              <span class="relative">1 {data.unit}</span>
            </span>
          ))}
        </div>
        <p class="flex items-center gap-2 font-mono text-[11px] text-muted">
          <span class="tl-key h-2 w-4 rounded-sm" />{data.before}<span class="text-dim">→</span><span class="size-2 rounded-sm bg-accent" />{data.after}
        </p>
      </div>
    )
  }

  {
    viz === 'shrink' && (
      <div class="flex h-full flex-col justify-end gap-3 font-mono text-[11px] text-muted">
        <div>
          <p>{data.fromLabel}</p>
          <span class="mt-1.5 block h-2 rounded-full bg-line-strong" />
        </div>
        <div>
          <p>{data.toLabel}</p>
          <span class="mt-1.5 block h-2 rounded-full bg-line/60">
            <span class="shrink-bar block h-full rounded-full bg-accent" style={`--ratio: ${n('ratio')}`} />
          </span>
        </div>
      </div>
    )
  }

  {
    viz === 'matrix' && (
      <div class="flex h-full flex-col justify-end gap-3">
        <div class="grid gap-[3px]" style={`grid-template-columns: repeat(${n('cols')}, minmax(0, 1fr))`}>
          {Array.from({ length: n('count') }, (_, i) => (
            <span class="cell aspect-square rounded-[2px] bg-accent/70" style={`--c: ${i % n('cols')}`} />
          ))}
        </div>
        <p class="font-mono text-[11px] text-muted">One cell per workflow</p>
      </div>
    )
  }

  {
    viz === 'chain' && (
      <div class="flex h-full flex-col justify-end gap-3">
        <div class="relative flex items-center justify-between px-1">
          <span class="chain-line absolute inset-x-3 top-1/2 h-px bg-accent/50" />
          {Array.from({ length: n('count') }, (_, i) => (
            <span class="node relative flex size-9 items-center justify-center rounded-full border border-accent bg-canvas font-mono text-xs text-accent" style={`--d: ${i}`}>
              {i + 1}
            </span>
          ))}
        </div>
        <p class="font-mono text-[11px] text-muted">
          {data.count} {data.label}, one automated flow
        </p>
      </div>
    )
  }

  {
    viz === 'percentile' && (
      <div class="flex h-full flex-col justify-end gap-2">
        <div class="relative h-8">
          <span class="absolute inset-x-0 top-1/2 h-2 -translate-y-1/2 rounded-full bg-line/70" />
          <span class="pct-fill absolute top-1/2 left-0 h-2 -translate-y-1/2 rounded-full bg-accent/40" style={`width: ${n('value')}%`} />
          <span class="pct-marker absolute top-0 flex -translate-x-1/2 flex-col items-center" style={`left: ${n('value')}%`}>
            <span class="h-8 w-0.5 rounded-full bg-accent" />
          </span>
        </div>
        <div class="flex justify-between font-mono text-[11px] text-muted">
          <span>0</span><span>50th</span><span class="text-accent">{data.label}</span>
        </div>
      </div>
    )
  }
</div>

<style>
  .viz {
    height: clamp(96px, 5rem + 2vw, 120px);
  }

  .tl-span,
  .tl-key {
    background: repeating-linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-amber) 55%, transparent) 0 4px,
      transparent 4px 8px
    );
    border: 1px solid color-mix(in oklab, var(--color-amber) 60%, transparent);
  }

  .blk {
    background: repeating-linear-gradient(135deg, color-mix(in oklab, var(--color-amber) 35%, transparent) 0 4px, transparent 4px 8px);
  }

  .blk-fill {
    background: color-mix(in oklab, var(--color-accent) 22%, var(--color-surface));
    border-radius: inherit;
  }

  .shrink-bar {
    transform-origin: left;
    transform: scaleX(var(--ratio));
  }

  .pct-fill {
    transform-origin: left;
  }

  /* Motion: initial states only apply before the card is revealed. */
  @media (prefers-reduced-motion: no-preference) {
    .tl-span,
    .shrink-bar,
    .pct-fill,
    .chain-line {
      transition: transform 1000ms var(--ease-out) 250ms;
    }
    .tl-span,
    .chain-line {
      transform-origin: left;
    }
    .tl-marker,
    .node,
    .pct-marker {
      transition:
        opacity 300ms var(--ease-out),
        transform 300ms var(--ease-out);
    }
    .tl-marker {
      transition-delay: 1250ms;
    }
    .node {
      transition-delay: calc(300ms + var(--d) * 120ms);
    }
    .pct-marker {
      transition-delay: 1100ms;
    }
    .blk-fill {
      transition: opacity 400ms var(--ease-out);
      transition-delay: calc(500ms + var(--d) * 250ms);
    }
    .cell {
      transition: opacity 300ms var(--ease-out);
      transition-delay: calc(250ms + var(--c) * 18ms);
    }

    :global(.js) :global([data-reveal]:not(.is-in)) .tl-span,
    :global(.js) :global([data-reveal]:not(.is-in)) .chain-line,
    :global(.js) :global([data-reveal]:not(.is-in)) .pct-fill {
      transform: scaleX(0);
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .tl-span {
      transform: scaleX(0);
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .shrink-bar {
      transform: scaleX(1);
    }
    :global(.js) :global([data-reveal]:not(.is-in)) .tl-marker,
    :global(.js) :global([data-reveal]:not(.is-in)) .node,
    :global(.js) :global([data-reveal]:not(.is-in)) .pct-marker,
    :global(.js) :global([data-reveal]:not(.is-in)) .blk-fill,
    :global(.js) :global([data-reveal]:not(.is-in)) .cell {
      opacity: 0;
    }
  }
</style>
