---
import type { HTMLTag, Polymorphic } from 'astro/types';

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
  reveal?: boolean;
  delay?: number;
};

const { as: Tag = 'div', reveal = true, delay = 0, class: className, ...attrs } = Astro.props;
// Only clickable panels get the cursor spotlight.
const interactive = Tag === 'a' || Tag === 'button';
---

<Tag
  class:list={['panel', interactive && 'panel--link', className]}
  data-reveal={reveal ? '' : undefined}
  style={delay ? `--i: ${delay}` : undefined}
  {...attrs}
>
  <slot />
</Tag>
