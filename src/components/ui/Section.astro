---
interface Props {
  id: string;
  index: string;
  eyebrow: string;
  title: string;
  intro?: string;
}

const { id, index, eyebrow, title, intro } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-title`} class="border-t border-line/60 py-20 sm:py-28">
  <div class="container-page">
    <header class="mb-12 max-w-2xl">
      <p class="font-mono text-xs tracking-widest text-accent uppercase">
        <span class="text-muted">{index} /</span>
        {eyebrow}
      </p>
      <h2 id={`${id}-title`} class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        {title}
      </h2>
      {intro && <p class="mt-4 text-base leading-relaxed text-muted">{intro}</p>}
    </header>
    <slot />
  </div>
</section>
