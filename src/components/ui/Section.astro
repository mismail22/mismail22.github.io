---
// Every section shares one header: a small accent label, the title, and an
// optional intro. `band` gives a section a full-bleed background for rhythm.
interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  intro?: string;
  band?: 'none' | 'cool' | 'warm';
  // Nav item this section highlights, when it isn't the section's own id
  navGroup?: string;
  class?: string;
}

const { id, title, eyebrow, intro, band = 'none', navGroup, class: className } = Astro.props;

const bands = {
  none: '',
  cool: 'bg-band border-y border-line',
  warm: 'bg-band-warm border-y border-line',
};
---

<section id={id} data-nav-group={navGroup} aria-labelledby={`${id}-title`} class:list={['relative py-24 sm:py-32', bands[band], className]}>
  <div class="container-page">
    <header class="mb-12 max-w-3xl sm:mb-16">
      {eyebrow && <p class="eyebrow" data-reveal>{eyebrow}</p>}
      <h2 id={`${id}-title`} class:list={['text-display', eyebrow && 'mt-3']} data-reveal style="--i: 1">
        {title}
      </h2>
      {
        intro && (
          <p class="text-lead mt-5 max-w-2xl text-muted" data-reveal style="--i: 2">
            {intro}
          </p>
        )
      }
    </header>
    <slot />
  </div>
</section>
