---
// Fleet governance as one path every action takes. A pulse travels the path
// a few times; the guardrail step stays marked because it is the point.
const steps = [
  { label: 'Live truth', note: 'Inventory, finance, and site data, read live' },
  { label: 'Policy', note: 'Which racks qualify, and why' },
  { label: 'Guardrail', note: 'Preview, batch caps, value limits', key: true },
  { label: 'Action', note: 'Deploy, rebalance, or retire' },
  { label: 'Audit', note: 'Who did what, when, and why' },
];
---

<figure class="loop" data-viz data-delay="200">
  <figcaption class="cap">How every fleet action flows</figcaption>
  <ol class="steps">
    {
      steps.map((step, index) => (
        <li class:list={['step', step.key && 'key']} style={`--n:${index}`}>
          <span class="num">0{index + 1}</span>
          <span class="label">{step.label}</span>
          <span class="note">{step.note}</span>
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .loop {
    margin: 0;
  }
  .cap {
    margin-bottom: 18px;
    color: var(--muted);
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 6px;
    padding-top: 16px;
    border-top: 2px solid var(--line-strong);
  }
  .step::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--line-strong);
  }
  .step::after {
    content: '';
    position: absolute;
    top: -2px;
    right: -10px;
    width: 10px;
    height: 2px;
    background: var(--line-strong);
  }
  .step:last-child::after {
    display: none;
  }
  .key {
    border-top-color: var(--signal);
  }
  .key::before {
    background: var(--signal);
    box-shadow: none;
  }
  .num {
    color: var(--dim);
    font: 600 10.5px/1 var(--mono);
    letter-spacing: 0.08em;
  }
  .label {
    color: var(--ink);
    font-size: 19px;
    font-weight: 800;
    font-stretch: 75%;
    line-height: 1;
    text-transform: uppercase;
  }
  .note {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.4;
  }

  /* The pulse: each step lights in turn, three passes, then rests. */
  .loop.played .step {
    animation: pass 4s linear 3;
    animation-delay: calc(var(--n) * 0.8s);
  }
  .loop.played .step::before {
    animation: pass-dot 4s linear 3;
    animation-delay: calc(var(--n) * 0.8s);
  }
  .loop.instant .step,
  .loop.instant .step::before {
    animation: none;
  }
  @keyframes pass {
    0%,
    100% {
      border-top-color: var(--line-strong);
    }
    4%,
    18% {
      border-top-color: var(--signal);
    }
    30% {
      border-top-color: var(--line-strong);
    }
  }
  @keyframes pass-dot {
    0%,
    100% {
      background: var(--bg);
      box-shadow: inset 0 0 0 2px var(--line-strong);
    }
    4%,
    18% {
      background: var(--signal);
      box-shadow: 0 0 0 4px rgb(255 176 32 / 0.18);
    }
    30% {
      background: var(--bg);
      box-shadow: inset 0 0 0 2px var(--line-strong);
    }
  }

  @media (max-width: 767px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      padding-left: 6px;
    }
    .step {
      grid-template-columns: 44px 1fr;
      column-gap: 8px;
      padding: 0 0 16px 18px;
      border-top: 0;
      border-left: 2px solid var(--line-strong);
    }
    .step::before {
      top: 2px;
      left: -6px;
    }
    .step::after {
      display: none;
    }
    .key {
      border-left-color: var(--signal);
    }
    .num {
      grid-row: span 2;
      padding-top: 4px;
    }
    @keyframes pass {
      0%,
      100% {
        border-left-color: var(--line-strong);
      }
      4%,
      18% {
        border-left-color: var(--signal);
      }
      30% {
        border-left-color: var(--line-strong);
      }
    }
  }
</style>
