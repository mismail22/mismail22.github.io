---
// Same workflow, same clock. The polling lane runs the full time; the event
// wake-up lane finishes at 43% of it.
const RATIO = 0.43;
const RUN = 2.6;
---

<figure class="race" data-viz data-delay="200" style={`--ratio:${RATIO};--run:${RUN}s`}>
  <figcaption class="cap">Run time of the same workflow</figcaption>
  <div class="lane slow">
    <span class="name">Polling</span>
    <span class="track">
      <span class="bar"></span>
      <span class="ticks" aria-hidden="true"></span>
    </span>
    <span class="time">1.00×</span>
  </div>
  <div class="lane fast">
    <span class="name">Event wake-up</span>
    <span class="track"><span class="bar"></span><span class="done" aria-hidden="true">✓</span></span>
    <span class="time">0.43×</span>
  </div>
  <p class="result"><strong>57% faster</strong> · timeouts eliminated</p>
</figure>

<style>
  .race {
    display: grid;
    gap: 14px;
    margin: 0;
  }
  .cap {
    margin-bottom: 4px;
    color: var(--muted);
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lane {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: 14px;
  }
  .name {
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .time {
    color: var(--muted);
    font: 500 12px/1 var(--mono);
    text-align: right;
  }
  .track {
    position: relative;
    height: 18px;
    background: var(--surface-2);
  }
  .bar {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    background: var(--line-strong);
    transform-origin: 0 50%;
  }
  .fast .bar {
    width: calc(var(--ratio) * 100%);
    background: var(--signal);
  }
  /* Polling checks: a tick every few percent of the run. */
  .ticks {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 calc(8% - 2px), rgb(10 11 13 / 0.7) calc(8% - 2px) 8%);
  }
  .done {
    position: absolute;
    top: 50%;
    left: calc(var(--ratio) * 100% + 8px);
    color: var(--signal);
    font-size: 13px;
    font-weight: 700;
    transform: translateY(-50%);
  }
  .result {
    margin-top: 6px;
    color: var(--muted);
    font-size: 14px;
  }
  .result strong {
    color: var(--ink);
    font-size: 22px;
    font-weight: 800;
    font-stretch: 75%;
    text-transform: uppercase;
  }

  /* Same rate for both bars, so the fast lane simply stops sooner. */
  :global(.js:not(.rm):not(.no-motion)) .race:not(.played) .bar {
    transform: scaleX(0);
  }
  :global(.js:not(.rm):not(.no-motion)) .race:not(.played) :is(.done, .result) {
    opacity: 0;
  }
  .race.played .bar {
    transition: transform var(--run) linear;
  }
  .race.played .fast .bar {
    transition-duration: calc(var(--run) * var(--ratio));
  }
  .race.played .done {
    transition: opacity 300ms ease calc(var(--run) * var(--ratio));
  }
  .race.played .result {
    transition: opacity 400ms ease calc(var(--run) * var(--ratio) + 200ms);
  }
  .race.instant :is(.bar, .done, .result) {
    transition: none;
  }

  @media (max-width: 479px) {
    .lane {
      grid-template-columns: 6.4rem minmax(0, 1fr) 3rem;
      gap: 10px;
    }
    .name {
      font-size: 11.5px;
    }
  }
</style>
