---
// A labelled percentage bar. `from` draws a ghost of the earlier value;
// `target` draws a marker. `min` zooms the axis (labelled, so it stays honest).
interface Props {
  value: number;
  from?: number;
  target?: number;
  min?: number;
  max?: number;
  targetLabel?: string;
}

const { value, from, target, min = 0, max = 100, targetLabel } = Astro.props;
const pct = (n: number) => `${(((n - min) / (max - min)) * 100).toFixed(2)}%`;
---

<div class="meter" data-viz data-delay="150" style={`--value:${pct(value)}`}>
  <div class="track">
    {from !== undefined && <span class="from" style={`width:${pct(from)}`} />}
    <span class="fill" />
    {target !== undefined && <span class="target" style={`left:${pct(target)}`} />}
  </div>
  <div class="axis" aria-hidden="true">
    <span>{min}%</span>
    {target !== undefined && <span class="target-label" style={`left:${pct(target)}`}>{targetLabel ?? `${target}% target`}</span>}
    <span>{max}%</span>
  </div>
</div>

<style>
  .track {
    position: relative;
    height: 12px;
    background: var(--surface-2);
  }
  .from {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--line-strong);
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--value);
    background: var(--ink);
    transform-origin: 0 50%;
    transition: transform 1100ms cubic-bezier(0.3, 0.7, 0.3, 1);
  }
  .from + .fill {
    background: var(--signal);
  }
  .target {
    position: absolute;
    top: -5px;
    bottom: -5px;
    width: 2px;
    margin-left: -1px;
    background: var(--signal);
  }
  .axis {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    color: var(--dim);
    font: 500 10.5px/1 var(--mono);
    letter-spacing: 0.04em;
  }
  .target-label {
    position: absolute;
    top: 0;
    color: var(--signal);
    transform: translateX(-50%);
    white-space: nowrap;
  }
  :global(.js:not(.rm):not(.no-motion)) .meter:not(.played) .fill {
    transform: scaleX(0);
  }
  .instant .fill {
    transition: none;
  }
</style>
