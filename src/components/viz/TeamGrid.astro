---
// 5 → 24: the people who started, then everyone added over two years.
const START = 5;
const END = 24;
const COLS = 8;
const SIZE = 22;
const GAP = 12;
const rows = Math.ceil(END / COLS);
const width = COLS * SIZE + (COLS - 1) * GAP;
const height = rows * SIZE + (rows - 1) * GAP;
---

<figure class="team" data-viz data-delay="200">
  <svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true" focusable="false">
    {
      Array.from({ length: END }, (_, i) => (
        <circle
          class:list={['p', i < START ? 'first' : 'added']}
          cx={(i % COLS) * (SIZE + GAP) + SIZE / 2}
          cy={Math.floor(i / COLS) * (SIZE + GAP) + SIZE / 2}
          r={SIZE / 2}
          style={`--d:${Math.max(0, i - START) * 45}`}
        />
      ))
    }
  </svg>
  <figcaption class="legend">
    <span><i class="sw first"></i>5 at the start</span>
    <span><i class="sw added"></i>19 added over two years</span>
  </figcaption>
</figure>

<style>
  .team {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 380px;
    height: auto;
  }
  .first {
    fill: var(--signal);
  }
  .added {
    fill: var(--ink);
    stroke: transparent;
    stroke-width: 1.5;
    transition:
      fill 300ms ease,
      stroke 300ms ease;
    transition-delay: calc(var(--d) * 1ms);
  }
  :global(.js:not(.rm):not(.no-motion)) .team:not(.played) .added {
    fill: transparent;
    stroke: var(--line-strong);
  }
  .instant .added {
    transition: none;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-top: 16px;
    color: var(--muted);
    font: 500 11px/1.3 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .sw.first {
    background: var(--signal);
  }
  .sw.added {
    background: var(--ink);
  }
</style>
