---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { withBase } from '../lib/format';
---

<BaseLayout title={`Page not found · ${site.name}`}>
  <Navbar />
  <main id="main" class="wrap lost">
    <p class="eyebrow">404 · No route to host</p>
    <h1 class="display-l">This page<br />doesn't exist.</h1>
    <p class="lead">The link may be outdated, or the page may have moved.</p>
    <div class="actions">
      <a class="btn btn--primary" href={withBase('/')}><span aria-hidden="true">←</span> Back to home</a>
      <a class="btn btn--ghost" href={withBase('/work')}>See the work</a>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .lost {
    display: grid;
    align-content: center;
    gap: 22px;
    min-height: calc(100svh - var(--nav-h) - 82px);
    padding-block: 64px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }
</style>
