---
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Incidents from '../components/Incidents.astro';
import Journey from '../components/Journey.astro';
import Navbar from '../components/Navbar.astro';
import Principles from '../components/Principles.astro';
import Systems from '../components/Systems.astro';
import TeamBuild from '../components/TeamBuild.astro';
import Telemetry from '../components/Telemetry.astro';
import Toolbox from '../components/Toolbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <Hero />
    <Telemetry />
    <Systems />
    <Incidents />
    <Principles />
    <TeamBuild />
    <Toolbox />
    <Journey />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
