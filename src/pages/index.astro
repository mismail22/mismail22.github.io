---
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Beyond from '../components/home/Beyond.astro';
import Hero from '../components/home/Hero.astro';
import Systems from '../components/home/Systems.astro';
import Teams from '../components/home/Teams.astro';
import Navbar from '../components/Navbar.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Navbar current="home" />
  <main id="main" tabindex="-1">
    <Hero />
    <Systems />
    <Teams />
    <Beyond />
    <Contact />
  </main>
  <Footer />
</BaseLayout>

<style>
  main:focus {
    outline: none;
  }
</style>
