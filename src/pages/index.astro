---
import Business from '../components/Business.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Journey from '../components/Journey.astro';
import Leadership from '../components/Leadership.astro';
import Navbar from '../components/Navbar.astro';
import OrgGrowth from '../components/OrgGrowth.astro';
import Projects from '../components/Projects.astro';
import Telemetry from '../components/Telemetry.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Navbar />
  <main id="main" tabindex="-1" class="focus:outline-none">
    <Hero />
    <Telemetry />
    <Leadership />
    <OrgGrowth />
    <Projects />
    <Business />
    <Journey />
    <Contact />
